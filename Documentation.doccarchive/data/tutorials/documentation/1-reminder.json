{"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"role":"project","categoryPathComponent":"0-TOC","title":"Building Reminders","category":"Class 5 - Concurrency"},"variants":[{"paths":["\/tutorials\/documentation\/1-reminder"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"project","identifier":{"url":"doc:\/\/Documentation\/tutorials\/Documentation\/1-Reminder","interfaceLanguage":"swift"},"sections":[{"kind":"hero","image":"1-0-0.png","title":"Building Reminders","content":[{"inlineContent":[{"type":"text","text":"Get your project started and build a representation of Reminders in code."}],"type":"paragraph"}],"chapter":"What's in a Reminder?","estimatedTimeInMinutes":15,"backgroundImage":"1-0-0.png"},{"kind":"tasks","tasks":[{"anchor":"Setting-Up-The-Project","contentSection":[{"mediaPosition":"trailing","content":[{"inlineContent":[{"type":"text","text":"Before building the Reminder, you’ll create a new Swift Executable project using Swift Package Manager."}],"type":"paragraph"}],"media":"1-1-0.png","kind":"contentAndMedia"}],"title":"Setting Up The Project","stepsSection":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the Terminal to navigate to the directory you want to create the project folder in."}]},{"code":null,"content":[{"inlineContent":[{"type":"text","text":"Create a folder called Reminders."}],"type":"paragraph"}],"runtimePreview":null,"media":"1-1-1.png","caption":[],"type":"step"},{"content":[{"inlineContent":[{"type":"text","text":"Navigate into that folder and generate a new Swift Package Manager Executable for our project."}],"type":"paragraph"}],"caption":[],"type":"step","code":null,"media":"1-1-2.png","runtimePreview":null},{"type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"Open our Swift package in Xcode.","type":"text"}]}],"caption":[{"inlineContent":[{"text":"You can do this with the Terminal command ","type":"text"},{"code":"open Package.swift","type":"codeVoice"},{"text":", or by navigating to the directory in Finder and double-clicking on the Package.swift file.","type":"text"}],"type":"paragraph"}],"code":null,"runtimePreview":null,"media":"1-1-3.png"}]},{"stepsSection":[{"content":[{"inlineContent":[{"text":"First create a Reminder.swift file that we can place our struct into.","type":"text"}],"type":"paragraph"}],"type":"step","media":"1-2-1.png","caption":[],"code":null,"runtimePreview":null},{"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Define a Struct named Reminder."}]}],"type":"step","caption":[{"inlineContent":[{"type":"text","text":"Because Reminders will be sent asynchronously to cross concurrency boundaries, and will only be holding simple value types, Struct is the best choice for our Reminder type, for now."}],"type":"paragraph"}],"media":null,"code":"1-2-2.swift"},{"code":"1-2-3.swift","runtimePreview":null,"media":null,"type":"step","caption":[{"inlineContent":[{"text":"Our simple case only needs a ","type":"text"},{"type":"codeVoice","code":"Double"},{"text":" for the duration. In a real reminder app, a Date type would be more appropriate.","type":"text"}],"type":"paragraph"}],"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Define stored properties for the text of the Reminder, and a value for how long before the reminder gets sent."}]}]},{"inlineContent":[{"type":"text","text":"It’s best practice when dealing with values that represent Time to specify the units in the documentation for the property."}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"Add a documentation comment for our duration specifying the unit of time being measured.","type":"text"}],"type":"paragraph"}],"caption":[{"type":"paragraph","inlineContent":[{"text":"You can use the Command-Option-Slash ( ","type":"text"},{"inlineContent":[{"type":"text","text":"⌘-⌥-\/"}],"type":"strong"},{"text":" ) hotkey to auto-generate documentation stubs for any symbol in your code.","type":"text"}]}],"code":"1-2-3-comment.swift","runtimePreview":null,"type":"step","media":null},{"type":"step","code":"1-2-4.swift","content":[{"type":"paragraph","inlineContent":[{"text":"Define a stored property to hold a collection of strings to act as tags for the reminder. This allows users to more easily filter what reminders will show.","type":"text"}]}],"media":null,"runtimePreview":null,"caption":[{"type":"paragraph","inlineContent":[{"text":"Knowing that tags should be unique strings helps with deciding that this collection should be a Set of Strings. There would be no reason for a Reminder to have the same tag set twice!","type":"text"}]}]},{"caption":[],"code":"1-2-5.swift","runtimePreview":null,"media":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"Finally, make it so that if your Reminder is passed to the ","type":"text"},{"code":"print()","type":"codeVoice"},{"text":" function, it will print in a well-formatted way. For now, let’s just return the title and then the set of tags on the next line with an indentation.","type":"text"}]}]}],"title":"Create A Reminder Struct","contentSection":[{"media":"1-2-0.png","kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"text":"It’s time to create a custom Type to represent your Reminders in code.","type":"text"}]}],"mediaPosition":"trailing"}],"anchor":"Create-A-Reminder-Struct"}]},{"action":{"isActive":true,"overridingTitle":"Get started","type":"reference","overridingTitleInlineContent":[{"type":"text","text":"Get started"}],"identifier":"doc:\/\/Documentation\/tutorials\/Documentation\/2-Delivering"},"featuredEyebrow":"Tutorial","kind":"callToAction","title":"Delivering Reminders","abstract":[{"type":"text","text":"Deliver Reminders to the user by formatting them and printing them to the terminal."}]}],"hierarchy":{"reference":"doc:\/\/Documentation\/tutorials\/0-TOC","modules":[{"projects":[{"reference":"doc:\/\/Documentation\/tutorials\/Documentation\/1-Reminder","