{"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/Documentation\/tutorials\/Documentation\/4-Concurrency","interfaceLanguage":"swift"},"sections":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Modify your executable application to work well with Swift Concurrency."}]}],"title":"Swift Concurrency","kind":"hero","chapter":"What's in a Reminder?","image":"4-0-1.png","backgroundImage":"4-0-1.png","estimatedTimeInMinutes":15},{"kind":"tasks","tasks":[{"contentSection":[{"kind":"contentAndMedia","content":[{"inlineContent":[{"type":"text","text":"In Swift Concurrency, the best way to achieve parallel execution is with Task Groups. In order to have reminders print to the terminal based on their duration, you’ll need to think about how to create a Task Group that will print them correctly."}],"type":"paragraph"}],"mediaPosition":"trailing"}],"anchor":"Delivering-Reminders-Concurrently","stepsSection":[{"inlineContent":[{"type":"text","text":"The first place to look is the "},{"type":"codeVoice","code":"run()"},{"type":"text","text":" method."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Mark ","type":"text"},{"code":"run()","type":"codeVoice"},{"type":"text","text":" as "},{"code":"async","type":"codeVoice"},{"text":". This switches the function over to an async context so that you can utilize Swift Concurrency langauge features here.","type":"text"}]}],"code":"4-1-1.swift","type":"step","media":null,"runtimePreview":null,"caption":[]},{"runtimePreview":null,"type":"step","media":null,"code":"4-1-1-main.swift","caption":[],"content":[{"type":"paragraph","inlineContent":[{"text":"Modify main.swift to await the call to run(), now that it is asynchronous.","type":"text"}]}]},{"type":"paragraph","inlineContent":[{"text":"To determine how to create the Task Group, consider the goals of this function. ","type":"text"},{"type":"codeVoice","code":"run()"},{"text":" should print out every ","type":"text"},{"code":"Reminder","type":"codeVoice"},{"text":" in ","type":"text"},{"type":"codeVoice","code":"reminders"},{"type":"text","text":" after the "},{"type":"codeVoice","code":"reminder.duration"},{"text":" has passed. This tells us that we have a dynamic amount of concurrent tasks we want to spawn. As a result, the ","type":"text"},{"type":"codeVoice","code":"withTaskGroup(..."},{"text":" function seems to be the best choice.","type":"text"}]},{"type":"step","runtimePreview":null,"media":null,"content":[{"type":"paragraph","inlineContent":[{"text":"Add a call to the global ","type":"text"},{"type":"codeVoice","code":"withTaskGroup(..."},{"type":"text","text":" function around our existing code."}]}],"caption":[{"inlineContent":[{"text":"For the result type, we can use ","type":"text"},{"type":"codeVoice","code":"Void.self"},{"text":", as we are not returning a payload in each Task at the moment, but instead printing to the terminal.","type":"text"}],"type":"paragraph"}],"code":"4-1-2.swift"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add a new task to the group for each reminder."}]}],"code":"4-1-3.swift","runtimePreview":null,"type":"step","media":null,"caption":[]},{"code":"4-1-4.swift","runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Let’s also adjust our "},{"code":"sleep()","type":"codeVoice"},{"text":" call to use the newer and safer ","type":"text"},{"type":"codeVoice","code":"Task.sleep(for:)"}]}],"type":"step","media":null,"caption":[]},{"type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"When you run the program, you will once again see your reminders printing after the delay provided in the ","type":"text"},{"type":"codeVoice","code":"Reminder"},{"type":"text","text":" struct."}]}],"caption":[],"media":"2-2-4-image.png","runtimePreview":null,"code":null}],"title":"Delivering Reminders Concurrently"}]}],"kind":"project","hierarchy":{"reference":"doc:\/\/Documentation\/tutorials\/0-TOC","paths":[["doc:\/\/Documentation\/tutorials\/0-TOC","doc:\/\/Documentation\/tutorials\/0-TOC\/$volume","doc:\/\/Documentation\/tutorials\/0-TOC\/What's-in-a-Reminder-"]],"modules":[{"projects":[{"sections":[{"reference":"doc:\/\/Documentation\/tutorials\/Documentation\/1-Reminder#Setting-Up-The-Project","kind":"task"},{"reference":"doc:\/\/Documentation\/tutorials\/Documentation\/1-Reminder#Create-A-Reminder-Struct","kind":"task"}],"reference":"doc:\/\/Documentation\/tutorials\/Documentation\/1-Reminder"},{"reference":"doc:\/\/Documentation\/tutorials\/Documentation\/2-Delivering","sections":[{"kind":"task","reference":"doc:\/\/Documentation\/tutorials\/Documentation\/2-Delivering#Building-a-ReminderManager"},{"reference":"doc:\/\/Documentation\/tutorials\/Documentation\/2-Delivering#Building-and-Delivering-Reminders-In-mainswift","kind":"task"}]},{"reference":"doc:\/\/Documentation\/tutorials\/Documentation\/4-Concurrency","sections":[{"kind":"task","reference":"doc:\/\/Documentation\/tutorials\/Documentation\/4-Concurrency#Delivering-Reminders-Concurrently"}]}],"reference":"doc:\/\/Documentation\/tutorials\/0-TOC\/What's-in-a-Reminder-"}]},"variants":[{"paths":["\/tutorials\/documentation\/4-concurrency"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"category":"Class 5 - Concurrency","categoryPathComponent":"0-TOC","role":"project","title":"Swift Concurrency"},"references":{"doc://Documentation/tutorials/Documentation/2-Delivering#Building-and-Delivering-Reminders-In-mainswift":{"abstract":[{"type":"text","text":"Deliver Reminders to the user by formatting them and printing them to the terminal."}],"role":"pseudoSymbol","kind":"section","identifier":"doc:\/\/Documentation\/tutorials\/Documentation\/2-Delivering#Building-and-Delivering-Reminders-In-mainswift","type":"section","title":"Building and Delivering Reminders In main.swift","url":"\/tutorials\/documentation\/2-delivering#Building-and-Delivering-Reminders-In-mainswift"},"doc://Documentation/tutorials/Documentation/1-Reminder#Setting-Up-The-Project":{"identifier":"doc:\/\/Documentation\/tutorials\/Documentation\/1-Reminder#Setting-Up-The-Project","title":"Setting Up The Project","role":"pseudoSymbol","abstract":[{"type":"text","text":"Get your project started and build a representation of Reminders in code."}],"kind":"section","type":"section","url":"\/tutorials\/documentation\/1-reminder#Setting-Up-The-Project"},"doc://Documentation/tutorials/0-TOC":{"abstract":[{"type":"text","text":"Learn to create asynchronous code using Grand Central Dispatch and Swift Concurrency."}],"role":"overview","kind":"overview","identifier":"doc:\/\/Documentation\/tutorials\/0-TOC","type":"topic","title":"Class 5 - Concurrency","url":"\/tutorials\/0-toc"},"4-1-2.swift":{"content":["import Foundation","","class ReminderManager {","    ","    private var reminders: [Reminder] = []","    ","    func add(_ reminder: Reminder) {","        reminders.append(reminder)","    }","    ","    func run() async {","        await withTaskGroup(of: Void.self) { group in","            for reminder in reminders {","                sleep(UInt32(reminder.duration))","                print(reminder)","            }","        }","    }","}"],"identifier":"4-1-2.swift","fileType":"swift","syntax":"swift","type":"file","fileName":"ReminderManager.swift","highlights":[{"line":12},{"line":13},{"line":14},{"line":15},{"line":16}]},"4-1-1.swift":{"fileName":"ReminderManager.swift","syntax":"swift","identifier":"4-1-1.swift","fileType":"swift","type":"file","highlights":[{"line":11}],"content":["import Foundation","","class ReminderManager {","    ","    private var reminders: [Reminder] = []","    ","    func add(_ reminder: Reminder) {","        reminders.append(reminder)","    }","    ","    func run() async {","        for reminder in reminders {","            sleep(UInt32(reminder.duration))","            print(reminder)","        }","    }","}"]},"doc://Documentation/tutorials/Documentation/1-Reminder#Create-A-Reminder-Struct":{"identifier":"doc:\/\/Documentation\/tutorials\/Documentation\/1-Reminder#Create-A-Reminder-Struct","title":"Create A Reminder Struct","role":"pseudoSymbol","abstract":[{"type":"text","text":"Get your project started and build a representation of Reminders in code."}],"kind":"section","type":"section","url":"\/tutorials\/documentation\/1-reminder#Create-A-Reminder-Struct"},"4-1-4.swift":{"fileName":"ReminderManager.swift","syntax":"swift","identifier":"4-1-4.swift","fileType":"swift","type":"file","highlights":[{"line":15}],"content":["import Foundation","","class ReminderManager {","    ","    private var reminders: [Reminder] = []","    ","    func add(_ reminder: Reminder) {","        reminders.append(reminder)","    }","    ","    func run() async {","        await withTaskGroup(of: Void.self) { group in","            for reminder in reminders {","                group.addTask {","                    try? await Task.sleep(for: .seconds(reminder.duration))","                    print(reminder)","                }","            }","        }","    }","}"]},"doc://Documentation/tutorials/Documentation/1-Reminder":{"abstract":[{"type":"text","text":"Get your project started and build a representation of Reminders in code."}],"title":"Building Reminders","identifier":"doc:\/\/Documentation\/tutorials\/Documentation\/1-Reminder","url":"\/tutorials\/documentation\/1-reminder","kind":"project","estimatedTime":"15min","type":"topic","role":"project"},"2-2-4-image.png":{"alt":null,"type":"image","identifier":"2-2-4-image.png","variants":[{"url":"\/images\/Documentation\/2-2-4-image.png","traits":["1x","light"]}]},"4-0-1.png":{"alt":null,"type":"image","identifier":"4-0-1.png","variants":[{"url":"\/images\/Documentation\/4-0-1@2x.png","traits":["2x","light"]}]},"4-1-3.swift":{"content":["import Foundation","","class ReminderManager {","    ","    private var reminders: [Reminder] = []","    ","    func add(_ reminder: Reminder) {","        reminders.append(reminder)","    }","    ","    func run() async {","        await withTaskGroup(of: Void.self) { group in","            for reminder in reminders {","                group.addTask {","                    sleep(UInt32(reminder.duration))","                    print(reminder)","                }","            }","        }","    }","}"],"identifier":"4-1-3.swift","fileType":"swift","syntax":"swift","type":"file","fileName":"ReminderManager.swift","highlights":[{"line":14},{"line":15},{"line":16},{"line":17}]},"doc://Documentation/tutorials/Documentation/4-Concurrency":{"abstract":[{"type":"text","text":"Modify your executable application to work well with Swift Concurrency."}],"title":"Swift Concurrency","identifier":"doc:\/\/Documentation\/tutorials\/Documentation\/4-Concurrency","url":"\/tutorials\/documentation\/4-concurrency","kind":"project","estimatedTime":"15min","type":"topic","role":"project"},"doc://Documentation/tutorials/Documentation/2-Delivering#Building-a-ReminderManager":{"kind":"section","title":"Building a ReminderManager","type":"section","identifier":"doc:\/\/Documentation\/tutorials\/Documentation\/2-Delivering#Building-a-ReminderManager","abstract":[{"text":"Deliver Reminders to the user by formatting them and printing them to the terminal.","type":"text"}],"url":"\/tutorials\/documentation\/2-delivering#Building-a-ReminderManager","role":"pseudoSymbol"},"doc://Documentation/tutorials/Documentation/4-Concurrency#Delivering-Reminders-Concurrently":{"type":"section","url":"\/tutorials\/documentation\/4-concurrency#Delivering-Reminders-Concurrently","kind":"section","title":"Delivering Reminders Concurrently","role":"pseudoSymbol","abstract":[{"type":"text","text":"Modify your executable application to work well with Swift Concurrency."}],"identifier":"doc:\/\/Documentation\/tutorials\/Documentation\/4-Concurrency#Delivering-Reminders-Concurrently"},"doc://Documentation/tutorials/0-TOC/What's-in-a-Reminder-":{"type":"topic","url":"\/tutorials\/0-toc\/what's-in-a-reminder-","kind":"article","title":"What's in a Reminder?","role":"article","abstract":[],"identifier":"doc:\/\/Documentation\/tutorials\/0-TOC\/What's-in-a-Reminder-"},"doc://Documentation/tutorials/Documentation/2-Delivering":{"role":"project","type":"topic","identifier":"doc:\/\/Documentation\/tutorials\/Documentation\/2-Delivering","abstract":[{"type":"text","text":"Deliver Reminders to the user by formatting them and printing them to the terminal."}],"kind":"project","url":"\/tutorials\/documentation\/2-delivering","title":"Delivering Reminders","estimatedTime":"20min"},"4-1-1-main.swift":{"fileName":"main.swift","syntax":"swift","identifier":"4-1-1-main.swift","fileType":"swift","type":"file","highlights":[{"line":18}],"content":["let manager = ReminderManager()","let reminders = [","    Reminder(text: \"Do the dishes\",","             duration: 6,","             tags: [\"chore\"]),","    Reminder(text: \"Clean the litter\",","             duration: 12,","             tags: [\"chore\", \"cats\"]),","    Reminder(text: \"Dance like no one is watching\",","             duration: 3,","             tags: [\"fun\"])","]","","for reminder in reminders {","    manager.add(reminder)","}","","await manager.run()"]}}}