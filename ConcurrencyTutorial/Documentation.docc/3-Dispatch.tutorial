@Tutorial(time: 30) {
    @Intro(title: "Grand Central Dispatch") {
        Now let's add a bit of asynchronicity using GCD!
        
        @Image(source: 2-0-1)
    }
    
    @Section(title: "Section Title") {
        @ContentAndMedia {
            Section text
            @Image(source: 2-0-0)
        }
        
        @Steps {
            @Step {
                Step 1 text
            }
        }
    }
}
