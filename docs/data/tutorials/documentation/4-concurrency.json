},"2-2-4-image.png":{"alt":null,"identifier":"2-2-4-image.png","variants":[{"url":"\/images\/Documentation\/2-2-4-image.png","traits":["1x","light"]}],"type":"image"},"4-1-3.swift":{"highlights":[{"line":14},{"line":15},{"line":16},{"line":17}],"syntax":"swift","content":["import Foundation","","class ReminderManager {","    ","    private var reminders: [Reminder] = []","    ","    func add(_ reminder: Reminder) {","        reminders.append(reminder)","    }","    ","    func run() async {","        await withTaskGroup(of: Void.self) { group in","            for reminder in reminders {","                group.addTask {","                    sleep(UInt32(reminder.duration))","                    print(reminder)","                }","            }","        }","    }","}"],"identifier":"4-1-3.swift","fileName":"ReminderManager.swift","type":"file","fileType":"swift"},"4-1-1.swift":{"identifier":"4-1-1.swift","fileType":"swift","syntax":"swift","content":["import Foundation","","class ReminderManager {","    ","    private var reminders: [Reminder] = []","    ","    func add(_ reminder: Reminder) {","        reminders.append(reminder)","    }","    ","    func run() async {","        for reminder in reminders {","            sleep(UInt32(reminder.duration))","            print(reminder)","        }","    }","}"],"highlights":[{"line":11}],"fileName":"ReminderManager.swift","type":"file"},"doc://Documentation/tutorials/Documentation/2-Delivering#Building-and-Delivering-Reminders-In-mainswift":{"abstract":[{"type":"text","text":"Deliver Reminders to the user by formatting them and printing them to the terminal."}],"url":"\/tutorials\/documentation\/2-delivering#Building-and-Delivering-Reminders-In-mainswift","title":"Building and Delivering Reminders In main.swift","role":"pseudoSymbol","identifier":"doc:\/\/Documentation\/tutorials\/Documentation\/2-Delivering#Building-and-Delivering-Reminders-In-mainswift","type":"section","kind":"section"},"doc://Documentation/tutorials/Documentation/1-Reminder#Create-A-Reminder-Struct":{"identifier":"doc:\/\/Documentation\/tutorials\/Documentation\/1-Reminder#Create-A-Reminder-Struct","kind":"section","role":"pseudoSymbol","title":"Create A Reminder Struct","url":"\/tutorials\/documentation\/1-reminder#Create-A-Reminder-Struct","abstract":[{"type":"text","text":"Get your project started and build a representation of Reminders in code."}],"type":"section"},"doc://Documentation/tutorials/Documentation/2-Delivering#Building-a-ReminderManager":{"type":"section","kind":"section","abstract":[{"type":"text","text":"Deliver Reminders to the user by formatting them and printing them to the terminal."}],"url":"\/tutorials\/documentation\/2-delivering#Building-a-ReminderManager","identifier":"doc:\/\/Documentation\/tutorials\/Documentation\/2-Delivering#Building-a-ReminderManager","title":"Building a ReminderManager","role":"pseudoSymbol"},"doc://Documentation/tutorials/0-TOC/What's-in-a-Reminder-":{"url":"\/tutorials\/0-toc\/what's-in-a-reminder-","abstract":[],"title":"What's in a Reminder?","role":"article","identifier":"doc:\/\/Documentation\/tutorials\/0-TOC\/What's-in-a-Reminder-","type":"topic","kind":"article"},"doc://Documentation/tutorials/0-TOC":{"role":"overview","title":"Class 5 - Concurrency","kind":"overview","url":"\/tutorials\/0-toc","type":"topic","abstract":[{"text":"Learn to create asynchronous code using Grand Central Dispatch and Swift Concurrency.","type":"text"}],"identifier":"doc:\/\/Documentation\/tutorials\/0-TOC"},"doc://Documentation/tutorials/Documentation/1-Reminder#Setting-Up-The-Project":{"identifier":"doc:\/\/Documentation\/tutorials\/Documentation\/1-Reminder#Setting-Up-The-Project","kind":"section","role":"pseudoSymbol","title":"Setting Up The Project","url":"\/tutorials\/documentation\/1-reminder#Setting-Up-The-Project","abstract":[{"type":"text","text":"Get your project started and build a representation of Reminders in code."}],"type":"section"},"4-1-4.swift":{"highlights":[{"line":15}],"syntax":"swift","content":["import Foundation","","class ReminderManager {","    ","    private var reminders: [Reminder] = []","    ","    func add(_ reminder: Reminder) {","        reminders.append(reminder)","    }","    ","    func run() async {","        await withTaskGroup(of: Void.self) { group in","            for reminder in reminders {","                group.addTask {","                    try? await Task.sleep(for: .seconds(reminder.duration))","                    print(reminder)","                }","            }","        }","    }","}"],"identifier":"4-1-4.swift","type":"file","fileType":"swift","fileName":"ReminderManager.swift"},"4-1-1-main.swift":{"identifier":"4-1-1-main.swift","fileType":"swift","syntax":"swift","content":["let manager = ReminderManager()","let reminders = [","    Reminder(text: \"Do the dishes\",","             duration: 6,","             tags: [\"chore\"]),","    Reminder(text: \"Clean the litter\",","             duration: 12,","             tags: [\"chore\", \"cats\"]),","    Reminder(text: \"Dance like no one is watching\",","             duration: 3,","             tags: [\"fun\"])","]","","for reminder in reminders {","    manager.add(reminder)","}","","await manager.run()"],"highlights":[{"line":18}],"fileName":"main.swift","type":"file"},"4-1-2.swift":{"highlights":[{"line":12},{"line":13},{"line":14},{"line":15},{"line":16}],"syntax":"swift","content":["import Foundation","","class ReminderManager {","    ","    private var reminders: [Reminder] = []","    ","    func add(_ reminder: Reminder) {","        reminders.append(reminder)","    }","    ","    func run() async {","        await withTaskGroup(of: Void.self) { group in","            for reminder in reminders {","                sleep(UInt32(reminder.duration))","                print(reminder)","            }","        }","    }","}"],"identifier":"4-1-2.swift","fileName":"ReminderManager.swift","type":"file","fileType":"swift"},"doc://Do