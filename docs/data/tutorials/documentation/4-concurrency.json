oncurrently","anchor":"Delivering-Reminders-Concurrently","stepsSection":[{"type":"paragraph","inlineContent":[{"text":"The first place to look is the ","type":"text"},{"type":"codeVoice","code":"run()"},{"text":" method.","type":"text"}]},{"code":"4-1-1.swift","caption":[],"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Mark "},{"code":"run()","type":"codeVoice"},{"type":"text","text":" as "},{"code":"async","type":"codeVoice"},{"type":"text","text":". This switches the function over to an async context so that you can utilize Swift Concurrency langauge features here."}]}],"runtimePreview":null,"type":"step","media":null},{"runtimePreview":null,"code":"4-1-1-main.swift","type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Modify main.swift to await the call to run(), now that it is asynchronous."}]}],"media":null,"caption":[]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To determine how to create the Task Group, consider the goals of this function. "},{"code":"run()","type":"codeVoice"},{"text":" should print out every ","type":"text"},{"type":"codeVoice","code":"Reminder"},{"type":"text","text":" in "},{"type":"codeVoice","code":"reminders"},{"text":" after the ","type":"text"},{"type":"codeVoice","code":"reminder.duration"},{"type":"text","text":" has passed. This tells us that we have a dynamic amount of concurrent tasks we want to spawn. As a result, the "},{"type":"codeVoice","code":"withTaskGroup(..."},{"type":"text","text":" function seems to be the best choice."}]},{"content":[{"inlineContent":[{"type":"text","text":"Add a call to the global "},{"code":"withTaskGroup(...","type":"codeVoice"},{"type":"text","text":" function around our existing code."}],"type":"paragraph"}],"code":"4-1-2.swift","runtimePreview":null,"type":"step","media":null,"caption":[{"inlineContent":[{"text":"For the result type, we can use ","type":"text"},{"type":"codeVoice","code":"Void.self"},{"text":", as we are 