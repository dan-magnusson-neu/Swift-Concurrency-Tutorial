,"text":"Modify your executable application to work well with Swift Concurrency."}]}],"estimatedTimeInMinutes":15,"title":"Swift Concurrency","backgroundImage":"4-0-1.png","chapter":"What's in a Reminder?","image":"4-0-1.png"},{"kind":"tasks","tasks":[{"title":"Delivering Reminders Concurrently","anchor":"Delivering-Reminders-Concurrently","stepsSection":[{"type":"paragraph","inlineContent":[{"text":"The first place to look is the ","type":"text"},{"type":"codeVoice","code":"run()"},{"text":" method.","type":"text"}]},{"code":"4-1-1.swift","runtimePreview":null,"type":"step","caption":[],"media":null,"content":[{"inlineContent":[{"type":"text","text":"Mark "},{"code":"run()","type":"codeVoice"},{"type":"text","text":" as "},{"code":"async","type":"codeVoice"},{"text":". This switches the function over to an async context so that you can utilize Swift Concurrency langauge features here.","type":"text"}],"type":"paragraph"}]},{"code":"4-1-1-main.swift","content":[{"inlineContent":[{"type":"text","text":"Modify main.swift to await the call to run(), now that it is asynchronous."}],"type":"paragraph"}],"runtimePreview":null,"type":"step","media":null,"caption":[]},{"type":"paragraph","inlineContent":[{"text":"To determine how to create the Task Group, consider the goals of this function. ","type":"text"},{"type":"codeVoice","code":"run()"},{"type":"text","text":" should print out every "},{"type":"codeVoice","code":"Reminder"},{"text":" in ","type":"text"},{"type":"codeVoice","code":"reminders"},{"type":"text","text":" after the "},{"code":"reminder.duration","type":"codeVoice"},{"text":" has passed. This tells us that we have a dynamic amount of concurrent tasks we want to spawn. As a result, the ","type":"text"},{"type":"codeVoice","code":"withTaskGroup(..."},{"text":" function seems to be the best choice.","type":"text"}]},{"code":"4-1-2.swift","runtimePreview":null,"type":"step","media":null,"caption":[{"inlineContent":[{"text":"For the result type, we can use ","type":"text"},{"type":"codeVoice","code":"Void.self"},{"text":", as we are not returning a payload in each Task at the moment, but instead printing to the terminal.","type":"text"}],"type":"paragraph"}],"content":[{"type":"paragraph","inlineContent":[{"text":"Add a call to the global ","type":"text"},{"code":"withTaskGroup(...","type":"codeVoice"},{"type":"text","text":" function around our existing code."}]}]},{"code":"4-1-3.swift","content":[{"inlineContent":[{"text":"Add a new task to the group for each reminder.","type":"text"}],"type":"paragraph"}],"caption":[],"runtimePreview":null,"type":"step","media":null},{"content":[{"inlineContent":[{"type":"text","text":"Let’s also adjust our "},{"code":"sleep()","type":"codeVoice"},{"type":"text","text":" call to use the newer and safer "},{"code":"Task.sleep(for:)","type":"codeVoice"}],"type":"paragraph"}],"media":null,"code":"4-1-4.swift","runtimePreview":null,"type":"step","caption":[]},{"code":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"When you run the program, you will once again see your reminders printing after the delay provided in the "},{"code":"Reminder","type":"codeVoice"},{"type":"text","text":" struct."}]}],"caption":[],"media":"2-2-4-image.png","runtimePreview":null}],"contentSection":[{"mediaPosition":"trailing","kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"text":"In Swift Concurrency, the best way to achieve parallel execution is with Task Groups. In order to have reminders print to the terminal based on their duration, you’ll need to think about how to create a Task Group that will print them correctly.","type":"text"}]}]}]},{"anchor":"Formatting-Our-Tags","contentSection":[{"mediaPosition":"trailing","content":[{"inlineContent":[{"type":"text","text":"Currently the program is just printing out the default array value for a given tag. In this section you’ll update the description of our Reminder to properly format our Reminders."}],"type":"paragraph"}],"kind":"contentAndMedia"}],"title":"Formatting Our Tags","stepsSection":[]}]}],"references":{"4-1-3.swift":{"syntax":"swift","fileName":"ReminderManager.swift","content":["import Foundation","","class ReminderManager {","    ","    private var reminders: [Reminder] = []","    ","    func add(_ reminder: Reminder) {","        reminders.append(reminder)","    }","    ","    func run() async {","        await withTaskGroup(of: Void.self) { group in","            for reminder in reminders {","                group.addTask {","                    sleep(UInt32(reminder.duration))","                    print(reminder)","                }","            }","        }","    }","}"],"type":"file","fileType":"swift","highlights":[{"line":14},{"line":15},{"line":16},{"line":17}],"identifier":"4-1-3.swift"},"doc://ConcurrencyTutorial/tutorials/ConcurrencyTutorial/2-Delivering":{"title":"Delivering Reminders","url":"\/tutorials\/concurrencytutorial\/2-delivering","abstract":[{"type":"text","text":"Deliver Reminders to the user by formatting them and printing them to the terminal."}],"estimatedTime":"20min","identifier":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/2-Delivering","type":"topic","kind":"project","role":"project"},"doc://ConcurrencyTutorial/tutorials/ConcurrencyTutorial/4-Concurrency#Formatting-Our-Tags":{"type":"section","url":"\/tutorials\/concurrencytutorial\/4-concurrency#Formatting-Our-Tags","role":"pseudoSymbol","title":"Formatting Our Tags","abstract":[{"type":"text","text":"Modify your executable application to work well with Swift Concurrency."}],"kind":"section","identifier":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/4-Concurrency#Formatting-Our-Tags"},"doc://ConcurrencyTutorial/tutorials/ConcurrencyTutorial/2-Delivering#Building-and-Delivering-Reminders-In-mainswift":{"title":"Building and Delivering Reminders In main.swift","url":"\/tutorials\/concurrencytutorial\/2-delivering#Building-and-Deliver