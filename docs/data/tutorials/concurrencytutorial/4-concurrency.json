{"hierarchy":{"reference":"doc:\/\/ConcurrencyTutorial\/tutorials\/0-TOC","modules":[{"projects":[{"sections":[{"kind":"task","reference":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/1-Reminder#Setting-Up-The-Project"},{"reference":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/1-Reminder#Create-A-Reminder-Struct","kind":"task"}],"reference":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/1-Reminder"},{"reference":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/2-Delivering","sections":[{"reference":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/2-Delivering#Building-a-ReminderManager","kind":"task"},{"reference":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/2-Delivering#Building-and-Delivering-Reminders-In-mainswift","kind":"task"}]},{"reference":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/4-Concurrency","sections":[{"reference":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/4-Concurrency#Delivering-Reminders-Concurrently","kind":"task"}]}],"reference":"doc:\/\/ConcurrencyTutorial\/tutorials\/0-TOC\/What's-in-a-Reminder-"}],"paths":[["doc:\/\/ConcurrencyTutorial\/tutorials\/0-TOC","doc:\/\/ConcurrencyTutorial\/tutorials\/0-TOC\/$volume","doc:\/\/ConcurrencyTutorial\/tutorials\/0-TOC\/What's-in-a-Reminder-"]]},"variants":[{"paths":["\/tutorials\/concurrencytutorial\/4-concurrency"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/4-Concurrency","interfaceLanguage":"swift"},"kind":"project","metadata":{"title":"Swift Concurrency","categoryPathComponent":"0-TOC","role":"project","category":"Class 5 - Concurrency"},"sections":[{"backgroundImage":"4-0-1.png","estimatedTimeInMinutes":15,"image":"4-0-1.png","content":[{"inlineContent":[{"type":"text","text":"Modify your executable application to work well with Swift Concurrency."}],"type":"paragraph"}],"chapter":"What's in a Reminder?","title":"Swift Concurrency","kind":"hero"},{"kind":"tasks","tasks":[{"stepsSection":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The first place to look is the "},{"type":"codeVoice","code":"run()"},{"text":" method.","type":"text"}]},{"code":"4-1-1.swift","runtimePreview":null,"media":null,"caption":[],"type":"step","content":[{"inlineContent":[{"type":"text","text":"Mark "},{"code":"run()","type":"codeVoice"},{"type":"text","text":" as "},{"type":"codeVoice","code":"async"},{"text":". This switches the function over to an async context so that you can utilize Swift Concurrency langauge features here.","type":"text"}],"type":"paragraph"}]},{"type":"step","media":null,"caption":[],"content":[{"inlineContent":[{"type":"text","text":"Modify main.swift to await the call to run(), now that it is asynchronous."}],"type":"paragraph"}],"code":"4-1-1-main.swift","runtimePreview":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"To determine how to create the Task Group, consider the goals of this function. "},{"type":"codeVoice","code":"run()"},{"text":" should print out every ","type":"text"},{"type":"codeVoice","code":"Reminder"},{"type":"text","text":" in "},{"type":"codeVoice","code":"reminders"},{"type":"text","text":" after the "},{"code":"reminder.duration","type":"codeVoice"},{"type":"text","text":" has passed. This tells us that we have a dynamic amount of concurrent tasks we want to spawn. As a result, the "},{"code":"withTaskGroup(...","type":"codeVoice"},{"type":"text","text":" function seems to be the best choice."}]},{"code":"4-1-2.swift","type":"step","content":[{"inlineContent":[{"type":"text","text":"Add a call to the global "},{"code":"withTaskGroup(...","type":"codeVoice"},{"type":"text","text":" function around our existing code."}],"type":"paragraph"}],"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For the result type, we can use "},{"code":"Void.self","type":"codeVoice"},{"text":", as we are not returning a payload in each Task at the moment, but instead printing to the terminal.","type":"text"}]}],"runtimePreview":null,"media":null},{"caption":[],"runtimePreview":null,"media":null,"code":"4-1-3.swift","content":[{"inlineContent":[{"type":"text","text":"Add a new task to the group for each reminder."}],"type":"paragraph"}],"type":"step"},{"code":"4-1-4.swift","caption":[],"media":null,"content":[{"inlineContent":[{"text":"Let’s also adjust our ","type":"text"},{"type":"codeVoice","code":"sleep()"},{"text":" call to use the newer and safer ","type":"text"},{"type":"codeVoice","code":"Task.sleep(for:)"}],"type":"paragraph"}],"type":"step","runtimePreview":null},{"caption":[],"content":[{"type":"paragraph","inlineContent":[{"text":"When you run the program, you will once again see your reminders printing after the delay provided in the ","type":"text"},{"type":"codeVoice","code":"Reminder"},{"type":"text","text":" struct."}]}],"type":"step","code":null,"media":"2-2-4-image.png","runtimePreview":null}],"title":"Delivering Reminders Concurrently","contentSection":[{"mediaPosition":"trailing","kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"text":"In Swift Concurrency, the best way to achieve parallel execution is with Task Groups. In order to have reminders print to the terminal based on their duration, you’ll need to think about how to create a Task Group that will print them correctly.","type":"text"}]}]}],"anchor":"Delivering-Reminders-Concurrently"}]}],"references":{"doc://ConcurrencyTutorial/tutorials/0-TOC/What's-in-a-Reminder-":{"identifier":"doc:\/\/ConcurrencyTutorial\/tutorials\/0-TOC\/What's-in-a-Reminder-","role":"article","kind":"article","type":"topic","url":"\/tutorials\/0-toc\/what's-in-a-reminder-","abstract":[],"title":"What's in a Reminder?"},"doc://ConcurrencyTutorial/tutorials/ConcurrencyTutorial/2-Delivering#Building-and-Delivering-Reminders-In-mainswift":{"