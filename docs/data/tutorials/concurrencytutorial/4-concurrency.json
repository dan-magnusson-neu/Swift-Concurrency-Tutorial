","abstract":[{"type":"text","text":"Learn to create asynchronous code using Swift Concurrency."}]},"4-1-1-main.swift":{"type":"file","syntax":"swift","identifier":"4-1-1-main.swift","fileType":"swift","highlights":[{"line":18}],"content":["let manager = ReminderManager()","let reminders = [","    Reminder(text: \"Do the dishes\",","             duration: 6,","             tags: [\"chore\"]),","    Reminder(text: \"Clean the litter\",","             duration: 12,","             tags: [\"chore\", \"cats\"]),","    Reminder(text: \"Dance like no one is watching\",","             duration: 3,","             tags: [\"fun\"])","]","","for reminder in reminders {","    manager.add(reminder)","}","","await manager.run()"],"fileName":"main.swift"},"doc://ConcurrencyTutorial/tutorials/ConcurrencyTutorial/1-Reminder#Create-A-Reminder-Struct":{"type":"section","identifier":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/1-Reminder#Create-A-Reminder-Struct","url":"\/tutorials\/concurrencytutorial\/1-reminder#Create-A-Reminder-Struct","kind":"section","abstract":[{"text":"Get your project started and build a representation of Reminders in code.","type":"text"}],"title":"Create A Reminder Struct","role":"pseudoSymbol"},"doc://ConcurrencyTutorial/tutorials/ConcurrencyTutorial/2-Delivering":{"url":"\/tutorials\/concurrencytutorial\/2-delivering","role":"project","title":"Delivering Reminders","kind":"project","type":"topic","identifier":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/2-Delivering","abstract":[{"type":"text","text":"Deliver Reminders to the user by formatting them and printing them to the terminal."}],"estimatedTime":"20min"}}}