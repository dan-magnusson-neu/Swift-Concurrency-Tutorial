{"hierarchy":{"reference":"doc:\/\/ConcurrencyTutorial\/tutorials\/0-TOC","modules":[{"reference":"doc:\/\/ConcurrencyTutorial\/tutorials\/0-TOC\/What's-in-a-Reminder-","projects":[{"sections":[{"reference":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/1-Reminder#Setting-Up-The-Project","kind":"task"},{"kind":"task","reference":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/1-Reminder#Create-A-Reminder-Struct"}],"reference":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/1-Reminder"},{"sections":[{"reference":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/2-Delivering#Building-a-ReminderManager","kind":"task"},{"kind":"task","reference":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/2-Delivering#Building-and-Delivering-Reminders-In-mainswift"}],"reference":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/2-Delivering"},{"sections":[{"reference":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/4-Concurrency#Delivering-Reminders-Concurrently","kind":"task"},{"reference":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/4-Concurrency#Formatting-Our-Tags","kind":"task"}],"reference":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/4-Concurrency"}]}],"paths":[["doc:\/\/ConcurrencyTutorial\/tutorials\/0-TOC","doc:\/\/ConcurrencyTutorial\/tutorials\/0-TOC\/$volume","doc:\/\/ConcurrencyTutorial\/tutorials\/0-TOC\/What's-in-a-Reminder-"]]},"kind":"project","sections":[{"chapter":"What's in a Reminder?","estimatedTimeInMinutes":15,"kind":"hero","title":"Swift Concurrency","image":"4-0-1.png","backgroundImage":"4-0-1.png","content":[{"type":"paragraph","inlineContent":[{"text":"Modify your executable application to work well with Swift Concurrency.","type":"text"}]}]},{"kind":"tasks","tasks":[{"title":"Delivering Reminders Concurrently","anchor":"Delivering-Reminders-Concurrently","stepsSection":[{"inlineContent":[{"type":"text","text":"The first place to look is the "},{"code":"run()","type":"codeVoice"},{"type":"text","text":" method."}],"type":"paragraph"},{"runtimePreview":null,"type":"step","caption":[],"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Mark "},{"code":"run()","type":"codeVoice"},{"type":"text","text":" as "},{"code":"async","type":"codeVoice"},{"type":"text","text":". This switches the function over to an async context so that you can utilize Swift Concurrency langauge features here."}]}],"media":null,"code":"4-1-1.swift"},{"code":"4-1-1-main.swift","caption":[],"runtimePreview":null,"media":null,"type":"step","content":[{"inlineContent":[{"type":"text","text":"Modify main.swift to await the call to run(), now that it is asynchronous."}],"type":"paragraph"}]},{"inlineContent":[{"type":"text","text":"To determine how to create the Task Group, consider the goals of this function. "},{"type":"codeVoice","code":"run()"},{"text":" should print out every ","type":"text"},{"code":"Reminder","type":"codeVoice"},{"type":"text","text":" in "},{"type":"codeVoice","code":"reminders"},{"text":" after the ","type":"text"},{"code":"reminder.duration","type":"codeVoice"},{"type":"text","text":" has passed. This tells us that we have a dynamic amount of concurrent tasks we want to spawn. As a result, the "},{"type":"codeVoice","code":"withTaskGroup(..."},{"type":"text","text":" function seems to be the best choice."}],"type":"paragraph"},{"type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add a call to the global "},{"code":"withTaskGroup(...","type":"codeVoice"},{"text":" function around our existing code.","type":"text"}]}],"caption":[{"type":"paragraph","inlineContent":[{"text":"For the result type, we can use ","type":"text"},{"type":"codeVoice","code":"Void.self"},{"type":"text","text":", as we are not returning a payload in each Task at the moment, but instead printing to the terminal."}]}],"media":null,"code":"4-1-2.swift","runtimePreview":null},{"caption":[],"content":[{"type":"paragraph","inlineContent":[{"text":"Add a new task to the group for each reminder.","type":"text"}]}],"code":"4-1-3.swift","type":"step","runtimePreview":null,"media":null},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Let’s also adjust our "},{"type":"codeVoice","code":"sleep()"},{"type":"text","text":" call to use the newer and safer "},{"type":"codeVoice","code":"Task.sleep(for:)"}]}],"media":null,"caption":[],"runtimePreview":null,"type":"step","code":"4-1-4.swift"},{"content":[{"type":"paragraph","inlineContent":[{"text":"When you run the program, you will once again see your reminders printing after the delay provided in the ","type":"text"},{"code":"Reminder","type":"codeVoice"},{"type":"text","text":" struct."}]}],"runtimePreview":null,"media":"2-2-4-image.png","code":null,"type":"step","caption":[]}],"contentSection":[{"content":[{"inlineContent":[{"text":"In Swift Concurrency, the best way to achieve parallel execution is with Task Groups. In order to have reminders print to the terminal based on their duration, you’ll need to think about how to create a Task Group that will print them correctly.","type":"text"}],"type":"paragraph"}],"mediaPosition":"trailing","kind":"contentAndMedia"}]},{"contentSection":[{"kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"text":"Currently the program is just printing out the default array value for a given tag. In this section you’ll update the description of our Reminder to properly format our Reminders.","type":"text"}]}],"mediaPosition":"trailing"}],"stepsSection":[],"anchor":"Formatting-Our-Tags","title":"Formatting Our Tags"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/concurrencytutorial\/4-concurrency"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/4-Concurrency"},"metadata":{"role":"project","categoryPathComponent":"0-TOC","title":"Swift Concurrency","category":"Class 5 - Concurrency"},"references":{"4-1-1.swift":{"syntax":"swift","highlights":[{"line":11}],"type":"file","fileName":"ReminderManager.swift","fileType":"swift","content":["import Foundation","","class ReminderManager {","    ","    private var reminders: [Reminder] = []","    ","    func add(_ reminder: Reminder) {","        reminders.append(reminder)","    }","    ","    func run() async {","        for reminder in reminders {","            sleep(UInt32(reminder.duration))","            print(reminder)","        }","    }","}"],"identifier":"4-1-1.swift"},"doc://ConcurrencyTutorial/tutorials/ConcurrencyTutorial/1-Reminder":{"abstract":[{"type":"text","text":"Get your project started and build a representation of Reminders in code."}],"kind":"project","identifier":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/1-Reminder","type":"topic","role":"project","estimatedTime":"15min","url":"\/tutorials\/concurrencytutorial\/1-reminder","title":"Building Reminders"},"doc://ConcurrencyTutorial/tutorials/ConcurrencyTutorial/4-Concurrency#Delivering-Reminders-Concurrently":{"role":"pseudoSymbol","abstract":[{"text":"Modify your executable application to work well with Swift Concurrency.","type":"text"}],"type":"section","url":"\/tutorials\/concurrencytutorial\/4-concurrency#Delivering-Reminders-Concurrently","kind":"section","title":"Delivering Reminders Concurrently","identifier":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/4-Concurrency#Delivering-Reminders-Concurrently"},"doc://ConcurrencyTutorial/tutorials/0-TOC/What's-in-a-Reminder-":{"role":"article","identifier":"doc:\/\/ConcurrencyTutorial\/tutorials\/0-TOC\/What's-in-a-Reminder-","type":"topic","url":"\/tutorials\/0-toc\/what's-in-a-reminder-","abstract":[],"title":"What's in a Reminder?","kind":"article"},"2-2-4-image.png":{"variants":[{"url":"\/images\/ConcurrencyTutorial\/2-2-4-image.png","traits":["1x","light"]}],"alt":null,"type":"image","identifier":"2-2-4-image.png"},"doc://ConcurrencyTutorial/tutorials/ConcurrencyTutorial/2-Delivering#Building-a-ReminderManager":{"type":"section","title":"Building a ReminderManager","kind":"section","abstract":[{"text":"Deliver Reminders to the user by formatting them and printing them to the terminal.","type":"text"}],"identifier":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/2-Delivering#Building-a-ReminderManager","url":"\/tutorials\/concurrencytutorial\/2-delivering#Building-a-ReminderManager","role":"pseudoSymbol"},"4-1-3.swift":{"syntax":"swift","highlights":[{"line":14},{"line":15},{"line":16},{"line":17}],"type":"file","fileName":"ReminderManager.swift","fileType":"swift","content":["import Foundation","","class ReminderManager {","    ","    private var reminders: [Reminder] = []","    ","    func add(_ reminder: Reminder) {","        reminders.append(reminder)","    }","    ","    func run() async {","        await withTaskGroup(of: Void.self) { group in","            for reminder in reminders {","                group.addTask {","                    sleep(UInt32(reminder.duration))","                    print(reminder)","                }","            }","        }","    }","}"],"identifier":"4-1-3.swift"},"4-0-1.png":{"type":"image","identifier":"4-0-1.png","variants":[{"url":"\/images\/ConcurrencyTutorial\/4-0-1@2x.png","traits":["2x","light"]}],"alt":null},"doc://ConcurrencyTutorial/tutorials/ConcurrencyTutorial/4-Concurrency#Formatting-Our-Tags":{"role":"pseudoSymbol","abstract":[{"text":"Modify your executable application to work well with Swift Concurrency.","type":"text"}],"type":"section","url":"\/tutorials\/concurrencytutorial\/4-concurrency#Formatting-Our-Tags","kind":"section","title":"Formatting Our Tags","identifier":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/4-Concurrency#Formatting-Our-Tags"},"doc://ConcurrencyTutorial/tutorials/ConcurrencyTutorial/4-Concurrency":{"role":"project","abstract":[{"type":"text","text":"Modify your executable application to work well with Swift Concurrency."}],"url":"\/tutorials\/concurrencytutorial\/4-concurrency","title":"Swift Concurrency","identifier":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/4-Concurrency","kind":"project","type":"topic","estimatedTime":"15min"},"doc://ConcurrencyTutorial/tutorials/ConcurrencyTutorial/2-Delivering":{"abstract":[{"type":"text","text":"Deliver Reminders to the user by formatting them and printing them to the terminal."}],"kind":"project","identifier":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/2-Delivering","type":"topic","role":"project","estimatedTime":"20min","url":"\/tutorials\/concurrencytutorial\/2-delivering","title":"Delivering Reminders"},"doc://ConcurrencyTutorial/tutorials/ConcurrencyTutorial/2-Delivering#Building-and-Delivering-Reminders-In-mainswift":{"type":"section","title":"Building and Delivering Reminders In main.swift","kind":"section","abstract":[{"text":"Deliver Reminders to the user by formatting them and printing them to the terminal.","type":"text"}],"identifier":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/2-Delivering#Building-and-Delivering-Reminders-In-mainswift","url":"\/tutorials\/concurrencytutorial\/2-delivering#Building-and-Delivering-Reminders-In-mainswift","role":"pseudoSymbol"},"4-1-2.swift":{"type":"file","syntax":"swift","content":["import Foundation","","class ReminderManager {","    ","    private var reminders: [Reminder] = []","    ","    func add(_ reminder: Reminder) {","        reminders.append(reminder)","    }","    ","    func run() async {","        await withTaskGroup(of: Void.self) { group in","            for reminder in reminders {","                sleep(UInt32(reminder.duration))","                print(reminder)","            }","        }","    }","}"],"fileType":"swift","fileName":"ReminderManager.swift","identifier":"4-1-2.swift","highlights":[{"line":12},{"line":13},{"line":14},{"line":15},{"line":16}]},"4-1-1-main.swift":{"type":"file","fileName":"main.swift","syntax":"swift","content":["let manager = ReminderManager()","let reminders = [","    Reminder(text: \"Do the dishes\",","             duration: 6,","             tags: [\"chore\"]),","    Reminder(text: \"Clean the litter\",","             duration: 12,","             tags: [\"chore\", \"cats\"]),","    Reminder(text: \"Dance like no one is watching\",","             duration: 3,","             tags: [\"fun\"])","]","","for reminder in reminders {","    manager.add(reminder)","}","","await manager.run()"],"identifier":"4-1-1-main.swift","highlights":[{"line":18}],"fileType":"swift"},"doc://ConcurrencyTutorial/tutorials/ConcurrencyTutorial/1-Reminder#Setting-Up-The-Project":{"type":"section","kind":"section","title":"Setting Up The Project","abstract":[{"text":"Get your project started and build a representation of Reminders in code.","type":"text"}],"identifier":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/1-Reminder#Setting-Up-The-Project","role":"pseudoSymbol","url":"\/tutorials\/concurrencytutorial\/1-reminder#Setting-Up-The-Project"},"doc://ConcurrencyTutorial/tutorials/ConcurrencyTutorial/1-Reminder#Create-A-Reminder-Struct":{"type":"section","title":"Create A Reminder Struct","kind":"section","abstract":[{"text":"Get your project started and build a representation of Reminders in code.","type":"text"}],"identifier":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/1-Reminder#Create-A-Reminder-Struct","url":"\/tutorials\/concurrencytutorial\/1-reminder#Create-A-Reminder-Struct","role":"pseudoSymbol"},"doc://ConcurrencyTutorial/tutorials/0-TOC":{"url":"\/tutorials\/0-toc","role":"overview","kind":"overview","abstract":[{"text":"Learn to create asynchronous code using Grand Central Dispatch and Swift Concurrency.","type":"text"}],"type":"topic","title":"Class 5 - Concurrency","identifier":"doc:\/\/ConcurrencyTutorial\/tutorials\/0-TOC"},"4-1-4.swift":{"type":"file","syntax":"swift","content":["import Foundation","","class ReminderManager {","    ","    private var reminders: [Reminder] = []","    ","    func add(_ reminder: Reminder) {","        reminders.append(reminder)","    }","    ","    func run() async {","        await withTaskGroup(of: Void.self) { group in","            for reminder in reminders {","                group.addTask {","                    try? await Task.sleep(for: .seconds(reminder.duration))","                    print(reminder)","                }","            }","        }","    }","}"],"fileType":"swift","fileName":"ReminderManager.swift","identifier":"4-1-4.swift","highlights":[{"line":15}]}}}