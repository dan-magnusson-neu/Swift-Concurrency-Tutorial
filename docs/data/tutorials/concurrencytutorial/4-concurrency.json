reminder: Reminder) {","        reminders.append(reminder)","    }","    ","    func run() async {","        await withTaskGroup(of: Void.self) { group in","            for reminder in reminders {","                group.addTask {","                    sleep(UInt32(reminder.duration))","                    print(reminder)","                }","            }","        }","    }","}"]},"doc://ConcurrencyTutorial/tutorials/ConcurrencyTutorial/1-Reminder#Create-A-Reminder-Struct":{"role":"pseudoSymbol","title":"Create A Reminder Struct","abstract":[{"type":"text","text":"Get your project started and build a representation of Reminders in code."}],"type":"section","url":"\/tutorials\/concurrencytutorial\/1-reminder#Create-A-Reminder-Struct","identifier":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/1-Reminder#Create-A-Reminder-Struct","kind":"section"},"doc://ConcurrencyTutorial/tutorials/0-TOC":{"url":"\/tutorials\/0-toc","abstract":[{"text":"Learn to create asynchronous code using Swift Concurrency.","type":"text"}],"title":"Class 5 - Concurrency","role":"overview","kind":"overview","identifier":"doc:\/\/ConcurrencyTutorial\/tutorials\/0-TOC","type":"topic"},"doc://ConcurrencyTutorial/tutorials/ConcurrencyTutorial/4-Concurrency#Delivering-Reminders-Concurrently":{"role":"pseudoSymbol","kind":"section","url":"\/tutorials\/concurrencytutorial\/4-concurrency#Delivering-Reminders-Concurrently","title":"Delivering Reminders Concurrently","abstract":[{"type":"text","text":"Modify your executable application to work well with Swift Concurrency."}],"type":"section","identifier":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/4-Concurrency#Delivering-Reminders-Concurrently"},"doc://ConcurrencyTutorial/tutorials/ConcurrencyTutorial/2-Delivering":{"estimatedTime":"20min","role":"project","kind":"project","identifier":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/2-Delivering","title":"Delivering Reminders","url":"\/tutorials\/concurre