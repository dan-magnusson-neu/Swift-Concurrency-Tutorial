{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/concurrencytutorial\/4-concurrency"]}],"hierarchy":{"reference":"doc:\/\/ConcurrencyTutorial\/tutorials\/0-TOC","modules":[{"projects":[{"reference":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/1-Reminder","sections":[{"reference":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/1-Reminder#Setting-Up-The-Project","kind":"task"},{"reference":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/1-Reminder#Create-A-Reminder-Struct","kind":"task"}]},{"sections":[{"kind":"task","reference":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/2-Delivering#Building-a-ReminderManager"},{"kind":"task","reference":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/2-Delivering#Building-and-Delivering-Reminders-In-mainswift"}],"reference":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/2-Delivering"},{"sections":[{"kind":"task","reference":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/4-Concurrency#Delivering-Reminders-Concurrently"}],"reference":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/4-Concurrency"}],"reference":"doc:\/\/ConcurrencyTutorial\/tutorials\/0-TOC\/What's-in-a-Reminder-"}],"paths":[["doc:\/\/ConcurrencyTutorial\/tutorials\/0-TOC","doc:\/\/ConcurrencyTutorial\/tutorials\/0-TOC\/$volume","doc:\/\/ConcurrencyTutorial\/tutorials\/0-TOC\/What's-in-a-Reminder-"]]},"metadata":{"role":"project","title":"Swift Concurrency","categoryPathComponent":"0-TOC","category":"Class 5 - Concurrency"},"identifier":{"url":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/4-Concurrency","interfaceLanguage":"swift"},"sections":[{"estimatedTimeInMinutes":15,"content":[{"inlineContent":[{"text":"Modify your executable application to work well with Swift Concurrency.","type":"text"}],"type":"paragraph"}],"kind":"hero","backgroundImage":"4-0-1.png","chapter":"What's in a Reminder?","title":"Swift Concurrency","image":"4-0-1.png"},{"kind":"tasks","tasks":[{"anchor":"Delivering-Reminders-Concurrently","title":"Delivering Reminders Concurrently","contentSection":[{"kind":"contentAndMedia","mediaPosition":"trailing","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In Swift Concurrency, the best way to achieve parallel execution is with Task Groups. In order to have reminders print to the terminal based on their duration, you’ll need to think about how to create a Task Group that will print them correctly."}]}]}],"stepsSection":[{"inlineContent":[{"type":"text","text":"The first place to look is the "},{"code":"run()","type":"codeVoice"},{"type":"text","text":" method."}],"type":"paragraph"},{"runtimePreview":null,"caption":[],"content":[{"inlineContent":[{"type":"text","text":"Mark "},{"type":"codeVoice","code":"run()"},{"type":"text","text":" as "},{"type":"codeVoice","code":"async"},{"type":"text","text":". This switches the function over to an async context so that you can utilize Swift Concurrency langauge features here."}],"type":"paragraph"}],"type":"step","media":null,"code":"4-1-1.swift"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Modify main.swift to await the call to run(), now that it is asynchronous.","type":"text"}]}],"code":"4-1-1-main.swift","type":"step","caption":[],"media":null,"runtimePreview":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"To determine how to create the Task Group, consider the goals of this function. "},{"type":"codeVoice","code":"run()"},{"type":"text","text":" should print out every "},{"code":"Reminder","type":"codeVoice"},{"type":"text","text":" in "},{"type":"codeVoice","code":"reminders"},{"type":"text","text":" after the "},{"code":"reminder.duration","type":"codeVoice"},{"type":"text","text":" has passed. This tells us that we have a dynamic amount of concurrent tasks we want to spawn. As a result, the "},{"type":"codeVoice","code":"withTaskGroup(..."},{"text":" function seems to be the best choice.","type":"text"}]},{"type":"step","caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For the result type, we can use "},{"type":"codeVoice","code":"Void.self"},{"type":"text","text":", as we are not returning a payload in each Task at the moment, but instead printing to the terminal."}]}],"media":null,"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"text":"Add a call to the global ","type":"text"},{"type":"codeVoice","code":"withTaskGroup(..."},{"text":" function around our existing code.","type":"text"}]}],"code":"4-1-2.swift"},{"media":null,"type":"step","code":"4-1-3.swift","runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add a new task to the group for each reminder."}]}],"caption":[]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Let’s also adjust our "},{"type":"codeVoice","code":"sleep()"},{"text":" call to use the newer and safer ","type":"text"},{"type":"codeVoice","code":"Task.sleep(for:)"}]}],"media":null,"type":"step","caption":[],"runtimePreview":null,"code":"4-1-4.swift"},{"runtimePreview":null,"type":"step","media":"2-2-4-image.png","code":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"When you run the program, you will once again see your reminders printing after the delay provided in the "},{"type":"codeVoice","code":"Reminder"},{"text":" struct.","type":"text"}]}],"caption":[]}]}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"project","references":{"4-1-4.swift":{"type":"file","syntax":"swift","identifier":"4-1-4.swift","fileType":"swift","highlights":[{"line":15}],"content":["import Foundation","","class ReminderManager {","    ","    private var reminders: [Reminder] = []","    ","    func add(_ reminder: Reminder) {","        reminders.append(reminder)","    }","    ","    func run() async {","        await withTaskGroup(of: Void.self) { group in","            for reminder in reminders {","                group.addTask {","                    try? await Task.sleep(for: .seconds(reminder.duration))","                    print(reminder)","                }","            }","        }","    }","}"],"fileName":"ReminderManager.swift"},"4-1-2.swift":{"type":"file","content":["import Foundation","","class ReminderManager {","    ","    private var reminders: [Reminder] = []","    ","    func add(_ reminder: Reminder) {","        reminders.append(reminder)","    }","    ","    func run() async {","        await withTaskGroup(of: Void.self) { group in","            for reminder in reminders {","                sleep(UInt32(reminder.duration))","                print(reminder)","            }","        }","    }","}"],"identifier":"4-1-2.swift","fileName":"ReminderManager.swift","fileType":"swift","highlights":[{"line":12},{"line":13},{"line":14},{"line":15},{"line":16}],"syntax":"swift"},"4-0-1.png":{"type":"image","variants":[{"traits":["2x","light"],"url":"\/images\/ConcurrencyTutorial\/4-0-1@2x.png"}],"identifier":"4-0-1.png","alt":null},"doc://ConcurrencyTutorial/tutorials/0-TOC/What's-in-a-Reminder-":{"role":"article","title":"What's in a Reminder?","identifier":"doc:\/\/ConcurrencyTutorial\/tutorials\/0-TOC\/What's-in-a-Reminder-","abstract":[],"type":"topic","url":"\/tutorials\/0-toc\/what's-in-a-reminder-","kind":"article"},"doc://ConcurrencyTutorial/tutorials/ConcurrencyTutorial/2-Delivering#Building-and-Delivering-Reminders-In-mainswift":{"url":"\/tutorials\/concurrencytutorial\/2-delivering#Building-and-Delivering-Reminders-In-mainswift","role":"pseudoSymbol","title":"Building and Delivering Reminders In main.swift","kind":"section","type":"section","identifier":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/2-Delivering#Building-and-Delivering-Reminders-In-mainswift","abstract":[{"type":"text","text":"Deliver Reminders to the user by formatting them and printing them to the terminal."}]},"2-2-4-im