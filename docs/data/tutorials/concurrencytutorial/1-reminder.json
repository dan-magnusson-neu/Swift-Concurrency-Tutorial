{"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[{"title":"Building Reminders","image":"1-0-0.png","content":[{"type":"paragraph","inlineContent":[{"text":"Get your project started and build a representation of Reminders in code.","type":"text"}]}],"chapter":"What's in a Reminder?","estimatedTimeInMinutes":15,"kind":"hero","backgroundImage":"1-0-0.png"},{"tasks":[{"title":"Setting Up The Project","stepsSection":[{"type":"paragraph","inlineContent":[{"text":"Use the Terminal to navigate to the directory you want to create the project folder in.","type":"text"}]},{"caption":[],"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a folder called Reminders."}]}],"type":"step","code":null,"media":"1-1-1.png"},{"caption":[],"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Navigate into that folder and generate a new Swift Package Manager Executable for our project."}]}],"type":"step","media":"1-1-2.png","code":null,"runtimePreview":null},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Open our Swift package in Xcode."}]}],"caption":[{"inlineContent":[{"type":"text","text":"You can do this with the Terminal command "},{"code":"open Package.swift","type":"codeVoice"},{"text":", or by navigating to the directory in Finder and double-clicking on the Package.swift file.","type":"text"}],"type":"paragraph"}],"type":"step","code":null,"runtimePreview":null,"media":"1-1-3.png"}],"contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Before building the Reminder, you’ll create a new Swift Executable project using Swift Package Manager."}]}],"mediaPosition":"trailing","media":"1-1-0.png","kind":"contentAndMedia"}],"anchor":"Setting-Up-The-Project"},{"stepsSection":[{"caption":[],"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"First create a Reminder.swift file that we can place our struct into."}]}],"media":"1-2-1.png","type":"step","code":null,"runtimePreview":null},{"code":"1-2-2.swift","caption":[{"type":"paragraph","inlineContent":[{"text":"Because Reminders will be sent asynchronously to cross concurrency boundaries, and will only be holding simple value types, Struct is the best choice for our Reminder type, for now.","type":"text"}]}],"media":null,"type":"step","runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Define a Struct named Reminder."}]}]},{"type":"step","caption":[{"inlineContent":[{"text":"Our simple case only needs a ","type":"text"},{"code":"Double","type":"codeVoice"},{"type":"text","text":" for the duration. In a real reminder app, a Date type would be more appropriate."}],"type":"paragraph"}],"code":"1-2-3.swift","content":[{"type":"paragraph","inlineContent":[{"text":"Define stored properties for the text of the Reminder, and a value for how long before the reminder gets sent.","type":"text"}]}],"runtimePreview":null,"media":null},{"inlineContent":[{"type":"text","text":"It’s best practice when dealing with values that represent Time to specify the units in the documentation for the property."}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"Add a documentation comment for our duration specifying the unit of time being measured.","type":"text"}],"type":"paragraph"}],"caption":[{"inlineContent":[{"text":"You can use the Command-Option-Slash ( ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"⌘-⌥-\/"}]},{"text":" ) hotkey to auto-generate documentation stubs for any symbol in your code.","type":"text"}],"type":"paragraph"}],"code":"1-2-3-comment.swift","type":"step","runtimePreview":null,"media":null},{"type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"Define a stored property to hold a collection of strings to act as tags for the reminder. This allows users to more easily filter what reminders will show.","type":"text"}]}],"media":null,"caption":[{"inlineContent":[{"text":"Knowing that tags should be unique strings helps with deciding that this collection should be a Set of Strings. There would be no reason for a Reminder to have the same tag set twice!","type":"text"}],"type":"paragraph"}],"runtimePreview":null,"code":"1-2-4.swift"},{"media":null,"content":[{"inlineContent":[{"type":"text","text":"Finally, make it so that if your Reminder is passed to the "},{"code":"print()","type":"codeVoice"},{"type":"text","text":" function, it will print in a well-formatted way. For now, let’s just return the title and then the set of tags on the next line with an indentation."}],"type":"paragraph"}],"type":"step","caption":[],"code":"1-2-5.swift","runtimePreview":null}],"contentSection":[{"mediaPosition":"trailing","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"It’s time to create a custom Type to represent your Reminders in code."}]}],"kind":"contentAndMedia","media":"1-2-0.png"}],"title":"Create A Reminder Struct","anchor":"Create-A-Reminder-Struct"}],"kind":"tasks"},{"action":{"overridingTitle":"Get started","overridingTitleInlineContent":[{"type":"text","text":"Get started"}],"identifier":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/2-Delivering","type":"reference","isActive":true},"abstract":[{"type":"text","text":"Deliver Reminders to the user by formatting them and printing them to the terminal."}],"title":"Delivering Reminders","kind":"callToAction","featuredEyebrow":"Tutorial"}],"metadata":{"categoryPathComponent":"0-TOC","role":"project","category":"Class 5 - Concurrency","title":"Building Reminders"},"identifier":{"url":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/1-Reminder","interfaceLanguage":"swift"},"kind":"project","hierarchy":{"modules":[{"projects":[{"reference":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/1-Reminder","sections":[{"kind":"task","reference":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/1-Reminder#Setting-Up-The