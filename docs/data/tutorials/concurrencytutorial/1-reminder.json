{"identifier":{"url":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/1-Reminder","interfaceLanguage":"swift"},"sections":[{"chapter":"What's in a Reminder?","kind":"hero","image":"1-0-0.png","estimatedTimeInMinutes":15,"backgroundImage":"1-0-0.png","content":[{"inlineContent":[{"text":"Get your project started and build a representation of Reminders in code.","type":"text"}],"type":"paragraph"}],"title":"Building Reminders"},{"kind":"tasks","tasks":[{"stepsSection":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the Terminal to navigate to the directory you want to create the project folder in."}]},{"caption":[],"media":"1-1-1.png","runtimePreview":null,"code":null,"content":[{"inlineContent":[{"text":"Create a folder called Reminders.","type":"text"}],"type":"paragraph"}],"type":"step"},{"media":"1-1-2.png","type":"step","content":[{"inlineContent":[{"text":"Navigate into that folder and generate a new Swift Package Manager Executable for our project.","type":"text"}],"type":"paragraph"}],"runtimePreview":null,"caption":[],"code":null},{"type":"step","caption":[{"inlineContent":[{"text":"You can do this with the Terminal command ","type":"text"},{"type":"codeVoice","code":"open Package.swift"},{"text":", or by navigating to the directory in Finder and double-clicking on the Package.swift file.","type":"text"}],"type":"paragraph"}],"content":[{"inlineContent":[{"type":"text","text":"Open our Swift package in Xcode."}],"type":"paragraph"}],"code":null,"media":"1-1-3.png","runtimePreview":null}],"title":"Setting Up The Project","contentSection":[{"media":"1-1-0.png","kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Before building the Reminder, you’ll create a new Swift Executable project using Swift Package Manager."}]}],"mediaPosition":"trailing"}],"anchor":"Setting-Up-The-Project"},{"anchor":"Create-A-Reminder-Struct","stepsSection":[{"media":"1-2-1.png","caption":[],"type":"step","content":[{"inlineContent":[{"type":"text","text":"First create a Reminder.swift file that we can place our struct into."}],"type":"paragraph"}],"code":null,"runtimePreview":null},{"media":null,"caption":[{"type":"paragraph","inlineContent":[{"text":"Because Reminders will be sent asynchronously to cross concurrency boundaries, and will only be holding simple value types, Struct is the best choice for our Reminder type, for now.","type":"text"}]}],"type":"step","code":"1-2-2.swift","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Define a Struct named Reminder."}]}],"runtimePreview":null},{"type":"step","media":null,"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Our simple case only needs a "},{"code":"Double","type":"codeVoice"},{"text":" for the duration. In a real reminder app, a Date type would be more appropriate.","type":"text"}]}],"code":"1-2-3.swift","runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Define stored properties for the text of the Reminder, and a value for how long before the reminder gets sent."}]}]},{"inlineContent":[{"type":"text","text":"It’s best practice when dealing with values that represent Time to specify the units in the documentation for the property."}],"type":"paragraph"},{"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You can use the Command-Option-Slash ( "},{"type":"strong","inlineContent":[{"type":"text","text":"⌘-⌥-\/"}]},{"text":" ) hotkey to auto-generate documentation stubs for any symbol in your code.","type":"text"}]}],"code":"1-2-3-comment.swift","content":[{"type":"paragraph","inlineContent":[{"text":"Add a documentation comment for our duration specifying the unit of time being measured.","type":"text"}]}],"runtimePreview":null,"media":null,"type":"step"},{"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"text":"Define a stored property to hold a collection of strings to act as tags for the reminder. This allows users to more easily filter what reminders will show.","type":"text"}]}],"type":"step","media":null,"code":"1-2-4.swift","caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Knowing that tags should be unique strings helps with deciding that this collection should be a Set of Strings. There would be no reason for a Reminder to have the same tag set twice!"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Finally, make it so that if your Reminder is passed to the "},{"type":"codeVoice","code":"print()"},{"type":"text","text":" function, it will print in a well-formatted way. For now, let’s just return the title and then the set of tags on the next line with an indentation."}],"type":"paragraph"}],"code":"1-2-5.swift","runtimePreview":null,"caption":[],"type":"step","media":null}],"title":"Create A Reminder Struct","contentSection":[{"mediaPosition":"trailing","kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"It’s time to create a custom Type to represent your Reminders in code."}]}],"media":"1-2-0.png"}]}]},{"action":{"overridingTitleInlineContent":[{"text":"Get started","type":"text"}],"isActive":true,"type":"reference","overridingTitle":"Get started","identifier":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/2-Delivering"},"title":"Delivering Reminders","abstract":[{"type":"text","text":"Deliver Reminders to the user by formatting them and printing them to the terminal."}],"kind":"callToAction","featuredEyebrow":"Tutorial"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/concurrencytutorial\/1-reminder"]}],"metadata":{"role":"project","category":"Class 5 - Concurrency","title":"Building Reminders","categoryPathComponent":"0-TOC"},"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"modules":[{"reference":"doc:\/\/ConcurrencyTutorial\/tutorials\/0-TOC\/What's-in-a-Reminder-","projects":[{"reference":"doc:\/\/ConcurrencyT