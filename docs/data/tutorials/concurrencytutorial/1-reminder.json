{"kind":"project","variants":[{"paths":["\/tutorials\/concurrencytutorial\/1-reminder"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/1-Reminder"},"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[{"image":"1-0-0.png","title":"Building Reminders","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Get your project started and build a representation of Reminders in code."}]}],"backgroundImage":"1-0-0.png","chapter":"What's in a Reminder?","kind":"hero","estimatedTimeInMinutes":15},{"tasks":[{"anchor":"Setting-Up-The-Project","title":"Setting Up The Project","contentSection":[{"kind":"contentAndMedia","mediaPosition":"trailing","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Before building the Reminder, you’ll create a new Swift Executable project using Swift Package Manager."}]}],"media":"1-1-0.png"}],"stepsSection":[{"inlineContent":[{"text":"Use the Terminal to navigate to the directory you want to create the project folder in.","type":"text"}],"type":"paragraph"},{"code":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a folder called Reminders."}]}],"runtimePreview":null,"caption":[],"media":"1-1-1.png"},{"caption":[],"type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Navigate into that folder and generate a new Swift Package Manager Executable for our project."}]}],"media":"1-1-2.png","code":null,"runtimePreview":null},{"type":"step","caption":[{"type":"paragraph","inlineContent":[{"text":"You can do this with the Terminal command ","type":"text"},{"code":"open Package.swift","type":"codeVoice"},{"text":", or by navigating to the directory in Finder and double-clicking on the Package.swift file.","type":"text"}]}],"runtimePreview":null,"code":null,"media":"1-1-3.png","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Open our Swift package in Xcode."}]}]}]},{"title":"Create A Reminder Struct","stepsSection":[{"type":"step","caption":[],"code":null,"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"text":"First create a Reminder.swift file that we can place our struct into.","type":"text"}]}],"media":"1-2-1.png"},{"media":null,"content":[{"inlineContent":[{"text":"Define a Struct named Reminder.","type":"text"}],"type":"paragraph"}],"caption":[{"type":"paragraph","inlineContent":[{"text":"Because Reminders will be sent asynchronously to cross concurrency boundaries, and will only be holding simple value types, Struct is the best choice for our Reminder type, for now.","type":"text"}]}],"code":"1-2-2.swift","type":"step","runtimePreview":null},{"code":"1-2-3.swift","type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Define stored properties for the text of the Reminder, and a value for how long before the reminder gets sent."}]}],"runtimePreview":null,"media":null,"caption":[{"type":"paragraph","inlineContent":[{"text":"Our simple case only needs a ","type":"text"},{"code":"Double","type":"codeVoice"},{"type":"text","text":" for the duration. In a real reminder app, a Date type would be more appropriate."}]}]},{"inlineContent":[{"type":"text","text":"It’s best practice when dealing with values that represent Time to specify the units in the documentation for the property."}],"type":"paragraph"},{"caption":[{"type":"paragraph","inlineContent":[{"text":"You can use the Command-Option-Slash ( ","type":"text"},{"inlineContent":[{"type":"text","text":"⌘-⌥-\/"}],"type":"strong"},{"type":"text","text":" ) hotkey to auto-generate documentation stubs for any symbol in your code."}]}],"media":null,"code":"1-2-3-comment.swift","type":"step","runtimePreview":null,"content":[{"inlineContent":[{"text":"Add a documentation comment for our duration specifying the unit of time being measured.","type":"text"}],"type":"paragraph"}]},{"code":"1-2-4.swift","media":null,"type":"step","runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Define a stored property to hold a collection of strings to act as tags for the reminder. This allows users to more easily filter what reminders will show."}]}],"caption":[{"inlineContent":[{"type":"text","text":"Knowing that tags should be unique strings helps with deciding that this collection should be a Set of Strings. There would be no reason for a Reminder to have the same tag set twice!"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Finally, make it so that if your Reminder is passed to the "},{"code":"print()","type":"codeVoice"},{"text":" function, it will print in a well-formatted way. For now, let’s just return the title and then the set of tags on the next line with an indentation.","type":"text"}],"type":"paragraph"}],"type":"step","runtimePreview":null,"caption":[],"media":null,"code":"1-2-5.swift"}],"anchor":"Create-A-Reminder-Struct","contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"text":"It’s time to create a custom Type to represent your Reminders in code.","type":"text"}]}],"kind":"contentAndMedia","media":"1-2-0.png","mediaPosition":"trailing"}]}],"kind":"tasks"},{"kind":"callToAction","title":"Delivering Reminders","action":{"identifier":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/2-Delivering","type":"reference","overridingTitleInlineContent":[{"type":"text","text":"Get started"}],"isActive":true,"overridingTitle":"Get started"},"featuredEyebrow":"Tutorial","abstract":[{"type":"text","text":"Deliver Reminders to the user by formatting them and printing them to the terminal."}]}],"metadata":{"categoryPathComponent":"0-TOC","title":"Building Reminders","category":"Class 5 - Concurrency","role":"project"},"hierarchy":{"paths":[["doc:\/\/ConcurrencyTutorial\/tutorials\/0-TOC","doc:\/\/ConcurrencyTutorial\/tutorials\/0-TOC\/$volume","doc:\/\/