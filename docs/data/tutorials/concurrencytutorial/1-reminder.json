s","tasks":[{"anchor":"Setting-Up-The-Project","stepsSection":[{"type":"paragraph","inlineContent":[{"text":"Use the Terminal to navigate to the directory you want to create the project folder in.","type":"text"}]},{"caption":[],"code":null,"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a folder called Reminders."}]}],"type":"step","media":"1-1-1.png"},{"code":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Navigate into that folder and generate a new Swift Package Manager Executable for our project."}]}],"media":"1-1-2.png","caption":[],"runtimePreview":null},{"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Open our Swift package in Xcode."}]}],"media":"1-1-3.png","type":"step","code":null,"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You can do this with the Terminal command "},{"type":"codeVoice","code":"open Package.swift"},{"text":", or by navigating to the directory in Finder and double-clicking on the Package.swift file.","type":"text"}]}]}],"title":"Setting Up The Project","contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Before building the Reminder, you’ll create a new Swift Executable project using Swift Package Manager.","type":"text"}]}],"kind":"contentAndMedia","media":"1-1-0.png","mediaPosition":"trailing"}]},{"anchor":"Create-A-Reminder-Struct","contentSection":[{"content":[{"inlineContent":[{"type":"text","text":"It’s time to create a custom Type to represent your Reminders in code."}],"type":"paragraph"}],"mediaPosition":"trailing","kind":"contentAndMedia","media":"1-2-0.png"}],"title":"Create A Reminder Struct","stepsSection":[{"code":null,"runtimePreview":null,"caption":[],"type":"step","media":"1-2-1.png","content":[{"inlineContent":[{"text":"First create a Reminder.swift file that we can place our struct into.","type":"text"}],"type":"paragraph"}]},{"type":