{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/concurrencytutorial\/4-concurrency"]}],"hierarchy":{"paths":[["doc:\/\/ConcurrencyTutorial\/tutorials\/0-TOC","doc:\/\/ConcurrencyTutorial\/tutorials\/0-TOC\/$volume","doc:\/\/ConcurrencyTutorial\/tutorials\/0-TOC\/What's-in-a-Reminder-"]],"reference":"doc:\/\/ConcurrencyTutorial\/tutorials\/0-TOC","modules":[{"reference":"doc:\/\/ConcurrencyTutorial\/tutorials\/0-TOC\/What's-in-a-Reminder-","projects":[{"reference":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/1-Reminder","sections":[{"kind":"task","reference":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/1-Reminder#Setting-Up-The-Project"},{"reference":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/1-Reminder#Create-A-Reminder-Struct","kind":"task"}]},{"reference":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/2-Delivering","sections":[{"kind":"task","reference":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/2-Delivering#Building-a-ReminderManager"},{"kind":"task","reference":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/2-Delivering#Building-and-Delivering-Reminders-In-mainswift"}]},{"reference":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/4-Concurrency","sections":[{"kind":"task","reference":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/4-Concurrency#Delivering-Reminders-Concurrently"},{"reference":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/4-Concurrency#Formatting-Our-Tags","kind":"task"}]}]}]},"metadata":{"role":"project","category":"Class 5 - Concurrency","title":"Swift Concurrency","categoryPathComponent":"0-TOC"},"kind":"project","identifier":{"url":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/4-Concurrency","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[{"chapter":"What's in a Reminder?","kind":"hero","image":"4-0-1.png","content":[{"type":"paragraph","inlineContent":[{"text":"Modify your executable application to work well with Swift Concurrency.","type":"text"}]}],"estimatedTimeInMinutes":15,"backgroundImage":"4-0-1.png","title":"Swift Concurrency"},{"kind":"tasks","tasks":[{"stepsSection":[{"inlineContent":[{"type":"text","text":"The first place to look is the "},{"type":"codeVoice","code":"run()"},{"type":"text","text":" method."}],"type":"paragraph"},{"caption":[],"type":"step","media":null,"code":"4-1-1.swift","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Mark "},{"code":"run()","type":"codeVoice"},{"type":"text","text":" as "},{"code":"async","type":"codeVoice"},{"type":"text","text":". This switches the function over to an async context so that you can utilize Swift Concurrency langauge features here."}]}],"runtimePreview":null},{"code":"4-1-1-main.swift","type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"Modify main.swift to await the call to run(), now that it is asynchronous.","type":"text"}]}],"runtimePreview":null,"media":null,"caption":[]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To determine how to create the Task Group, consider the goals of this function. "},{"type":"codeVoice","code":"run()"},{"type":"text","text":" should print out every "},{"type":"codeVoice","code":"Reminder"},{"type":"text","text":" in "},{"code":"reminders","type":"codeVoice"},{"type":"text","text":" after the "},{"code":"reminder.duration","type":"codeVoice"},{"text":" has passed. This tells us that we have a dynamic amount of concurrent tasks we want to spawn. As a result, the ","type":"text"},{"code":"withTaskGroup(...","type":"codeVoice"},{"text":" function seems to be the best choice.","type":"text"}]},{"content":[{"inlineContent":[{"type":"text","text":"Add a call to the global "},{"code":"withTaskGroup(...","type":"codeVoice"},{"text":" function around our existing code.","type":"text"}],"type":"paragraph"}],"type":"step","code":"4-1-2.swift","caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For the result type, we can use "},{"code":"Void.self","type":"codeVoice"},{"type":"text","text":", as we are not returning a payload in each Task at the moment, but instead printing to the terminal."}]}],"media":null,"runtimePreview":null},{"media":null,"code":"4-1-3.swift","runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add a new task to the group for each reminder."}]}],"caption":[],"type":"step"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Let’s also adjust our ","type":"text"},{"type":"codeVoice","code":"sleep()"},{"type":"text","text":" call to use the newer and safer "},{"code":"Task.sleep(for:)","type":"codeVoice"}]}],"code":"4-1-4.swift","media":null,"runtimePreview":null,"caption":[],"type":"step"},{"type":"step","runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"When you run the program, you will once again see your reminders printing after the delay provided in the "},{"type":"codeVoice","code":"Reminder"},{"text":" struct.","type":"text"}]}],"media":"2-2-4-image.png","caption":[],"code":null}],"anchor":"Delivering-Reminders-Concurrently","contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In Swift Concurrency, the best way to achieve parallel execution is with Task Groups. In order to have reminders print to the terminal based on their duration, you’ll need to think about how to create a Task Group that will print them correctly."}]}],"kind":"contentAndMedia","mediaPosition":"trailing"}],"title":"Delivering Reminders Concurrently"},{"anchor":"Formatting-Our-Tags","title":"Formatting Our Tags","contentSection":[{"mediaPosition":"trailing","kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Currently the program is just printing out the default array value for a given tag. In this section you’ll update the description of our Reminder to properly format our Reminders."}]}]}],"stepsSection":[]}]}],"references":{"doc://ConcurrencyTutorial/tutorials/ConcurrencyTutorial/1-Reminder":{"abstract":[{"type":"text","text":"Get your project started and build a representation of Reminders in code."}],"type":"topic","kind":"project","title":"Building Reminders","role":"project","identifier":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/1-Reminder","estimatedTime":"15min","url":"\/tutorials\/concurrencytutorial\/1-reminder"},"doc://ConcurrencyTutorial/tutorials/ConcurrencyTutorial/4-Concurrency#Delivering-Reminders-Concurrently":{"abstract":[{"type":"text","text":"Modify your executable application to work well with Swift Concurrency."}],"type":"section","url":"\/tutorials\/concurrencytutorial\/4-concurrency#Delivering-Reminders-Concurrently","title":"Delivering Reminders Concurrently","kind":"section","identifier":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/4-Concurrency#Delivering-Reminders-Concurrently","role":"pseudoSymbol"},"4-1-2.swift":{"content":["import Foundation","","class ReminderManager {","    ","    private var reminders: [Reminder] = []","    ","    func add(_ reminder: Reminder) {","        reminders.append(reminder)","    }","    ","    func run() async {","        await withTaskGroup(of: Void.self) { group in","            for reminder in reminders {","                sleep(UInt32(reminder.duration))","                print(reminder)","            }","        }","    }","}"],"fileName":"ReminderManager.swift","identifier":"4-1-2.swift","syntax":"swift","fileType":"swift","highlights":[{"line":12},{"line":13},{"line":14},{"line":15},{"line":16}],"type":"file"},"4-1-4.swift":{"highlights":[{"line":15}],"identifier":"4-1-4.swift","fileName":"ReminderManager.swift","type":"file","content":["import Foundation","","class ReminderManager {","    ","    private var reminders: [Reminder] = []","    ","    func add(_ reminder: Reminder) {","        reminders.append(reminder)","    }","    ","    func run() async {","        await withTaskGroup(of: Void.self) { group in","            for reminder in reminders {","                group.addTask {","                    try? await Task.sleep(for: .seconds(reminder.duration))","                    print(reminder)","                }","            }","        }","    }","}"],"syntax":"swift","fileType":"swift"},"4-1-1-main.swift":{"content":["let manager = ReminderManager()","let reminders = [","    Reminder(text: \"Do the dishes\",","             duration: 6,","             tags: [\"chore\"]),","    Reminder(text: \"Clean the litter\",","             duration: 12,","             tags: [\"chore\", \"cats\"]),","    Reminder(text: \"Dance like no one is watching\",","             duration: 3,","             tags: [\"fun\"])","]","","for reminder in reminders {","    manager.add(reminder)","}","","await manager.run()"],"identifier":"4-1-1-main.swift","fileName":"main.swift","syntax":"swift","fileType":"swift","highlights":[{"line":18}],"type":"file"},"2-2-4-image.png":{"variants":[{"traits":["1x","light"],"url":"\/images\/ConcurrencyTutorial\/2-2-4-image.png"}],"identifier":"2-2-4-image.png","alt":null,"type":"image"},"doc://ConcurrencyTutorial/tutorials/0-TOC/What's-in-a-Reminder-":{"type":"topic","title":"What's in a Reminder?","url":"\/tutorials\/0-toc\/what's-in-a-reminder-","identifier":"doc:\/\/ConcurrencyTutorial\/tutorials\/0-TOC\/What's-in-a-Reminder-","abstract":[],"role":"article","kind":"article"},"doc://ConcurrencyTutorial/tutorials/ConcurrencyTutorial/4-Concurrency":{"title":"Swift Concurrency","role":"project","estimatedTime":"15min","kind":"project","identifier":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/4-Concurrency","type":"topic","url":"\/tutorials\/concurrencytutorial\/4-concurrency","abstract":[{"type":"text","text":"Modify your executable application to work well with Swift Concurrency."}]},"doc://Concurre