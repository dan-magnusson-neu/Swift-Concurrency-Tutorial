,"media":"1-2-1.png","code":null,"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"text":"First create a Reminder.swift file that we can place our struct into.","type":"text"}]}],"caption":[]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Define a Struct named Reminder."}]}],"type":"step","caption":[{"type":"paragraph","inlineContent":[{"text":"Because Reminders will be sent asynchronously to cross concurrency boundaries, and will only be holding simple value types, Struct is the best choice for our Reminder type, for now.","type":"text"}]}],"code":"1-2-2.swift","media":null,"runtimePreview":null},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Define stored properties for the text of the Reminder, and a value for how long before the reminder gets sent."}]}],"media":null,"code":"1-2-3.swift","runtimePreview":null,"type":"step","caption":[{"type":"paragraph","inlineContent":[{"text":"Our simple case only needs a ","type":"text"},{"code":"Double","type":"codeVoice"},{"type":"text","text":" for the duration. In a real reminder app, a Date type would be more appropriate."}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It’s best practice when dealing with values that represent Time to specify the units in the documentation for the property."}]},{"content":[{"inlineContent":[{"type":"text","text":"Add a documentation comment for our duration specifying the unit of time being measured."}],"type":"paragraph"}],"caption":[{"inlineContent":[{"text":"You can use the Command-Option-Slash ( ","type":"text"},{"type":"strong","inlineContent":[{"text":"⌘-⌥-\/","type":"text"}]},{"type":"text","text":" ) hotkey to auto-generate documentation stubs for any symbol in your code."}],"type":"paragraph"}],"media":null,"code":"1-2-3-comment.swift","type":"step","runtimePreview":null},{"caption":[{"inlineContent":[{"type":"text","text":"Knowing that tags should be unique strings helps with deciding that this collection should be a Set of Strings. There would be no reason for a Reminder to have the same tag set twice!"}],"type":"paragraph"}],"media":null,"runtimePreview":null,"code":"1-2-4.swift","type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"Define a stored property to hold a collection of strings to act as tags for the reminder. This allows users to more easily filter what reminders will show.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Finally, make it so that if your Reminder is passed to the ","type":"text"},{"code":"print()","type":"codeVoice"},{"text":" function, it will print in a well-formatted way. For now, let’s just return the title and then the set of tags on the next line with an indentation.","type":"text"}]}],"caption":[],"type":"step","media":null,"code":"1-2-5.swift","runtimePreview":null}]}],"kind":"tasks"},{"action":{"type":"reference","overridingTitleInlineContent":[{"type":"text","text":"Get started"}],"identifier":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/2-Delivering","overridingTitle":"Get started","isActive":true},"abstract":[{"type":"text","text":"Deliver Reminders to the user by formatting them and printing them to the terminal."}],"title":"Delivering Reminders","kind":"callToAction","featuredEyebrow":"Tutorial"}],"references":{"1-2-4.swift":{"content":["struct Reminder {","    let text: String","    \/\/\/ Time before the Reminder should fire, in seconds.","    let duration: Double","    let tags: Set<String>","}"],"syntax":"swift","type":"file","identifier":"1-2-4.swift","fileName":"Reminder.swift","highlights":[{"line":5}],"fileType":"swift"},"doc://ConcurrencyTutorial/tutorials/ConcurrencyTutorial/1-Reminder#Create-A-Reminder-Struct":{"abstract":[{"text":"Get your project started and build a representation of Reminders in code.","type":"text"}],"role":"pseudoSymbol","identifier":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/1-Reminder#Create