ontent":[{"type":"text","text":"Build a ReminderManager that keeps track of all active Reminders and prints them when necessary."}]}]}],"anchor":"Building-a-ReminderManager","stepsSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a new ReminderManager.swift file."}]}],"runtimePreview":null,"type":"step","caption":[],"media":null,"code":"2-1-1.swift"},{"type":"step","runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add a variable stored property, "},{"type":"codeVoice","code":"reminders"},{"text":" to the ","type":"text"},{"code":"ReminderManager","type":"codeVoice"},{"text":", so it can track the Reminders.","type":"text"}]}],"code":"2-1-2.swift","caption":[{"inlineContent":[{"type":"text","text":"By setting this property to private, you can prevent other developers from making "},{"code":"ReminderManager","type":"codeVoice"},{"text":" remove a ","type":"text"},{"type":"codeVoice","code":"Reminder"},{"type":"text","text":" when they shouldn’t."}],"type":"paragraph"}],"media":null},{"runtimePreview":null,"content":[{"inlineContent":[{"text":"Create a function to add Reminders to your ","type":"text"},{"type":"codeVoice","code":"reminders"},{"type":"text","text":" collection."}],"type":"paragraph"}],"caption":[{"inlineContent":[{"type":"text","text":"Because we don’t want others modifying our "},{"type":"codeVoice","code":"reminders"},{"type":"text","text":" externally in whatever way they want, we’ll need to “wrap” one of the functions of that property with one of our own. This is a fairly common pattern when building containers on top of other containers, and is similar to (but not quite) the Decorator pattern."}],"type":"paragraph"}],"code":"2-1-3.swift","type":"step","media":null},{"inlineContent":[{"type":"text","text":"To use the global sleep function, you need to import the library which defines it - Foundation."}],"type":"paragraph"},{"media":null,"type":"step","runtimePreview":n