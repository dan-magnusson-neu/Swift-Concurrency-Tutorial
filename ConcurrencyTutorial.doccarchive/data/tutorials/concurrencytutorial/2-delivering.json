","text":"Iterate through the list of reminders and add them to the manager."}]}],"caption":[{"type":"paragraph","inlineContent":[{"text":"You could also define an initiliazer for ","type":"text"},{"type":"codeVoice","code":"ReminderManager"},{"text":" and pass an array of reminders to that instead, but we want our interface to be able to add new reminders at later times.","type":"text"}]}],"code":"2-2-3.swift","runtimePreview":null},{"media":null,"type":"step","caption":[{"type":"paragraph","inlineContent":[{"text":"You should see something similar to the preview in your terminal.","type":"text"}]}],"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Call the run function on the manager."}]}],"code":"2-2-4.swift","runtimePreview":"2-2-4-image.png"}]}]},{"action":{"isActive":true,"overridingTitle":"Get started","overridingTitleInlineContent":[{"text":"Get started","type":"text"}],"identifier":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/4-Concurrency","type":"reference"},"kind":"callToAction","featuredEyebrow":"Tutorial","abstract":[{"type":"text","text":"Modify your executable application to work well with Swift Concurrency."}],"title":"Swift Concurrency"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/2-Delivering"},"metadata":{"role":"project","title":"Delivering Reminders","categoryPathComponent":"0-TOC","category":"Class 5 - Concurrency"},"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/concurrencytutorial\/2-delivering"]}],"references":{"doc://ConcurrencyTutorial/tutorials/ConcurrencyTutorial/1-Reminder#Create-A-Reminder-Struct":{"abstract":[{"text":"Get your project started and build a representation of Reminders in code.","type":"text"}],"role":"pseudoSymbol","identifier":"doc:\/\/ConcurrencyTutorial\/tutorials\/ConcurrencyTutorial\/1-Reminder#Create-A-Reminder-Struct","url":"\/tutoria