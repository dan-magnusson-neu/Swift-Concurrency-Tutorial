:"1-1-1.png","runtimePreview":null,"caption":[],"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a folder called Reminders."}]}],"type":"step"},{"caption":[],"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Navigate into that folder and generate a new Swift Package Manager Executable for our project."}]}],"code":null,"runtimePreview":null,"media":"1-1-2.png","type":"step"},{"caption":[{"type":"paragraph","inlineContent":[{"text":"You can do this with the Terminal command ","type":"text"},{"type":"codeVoice","code":"open Package.swift"},{"text":", or by navigating to the directory in Finder and double-clicking on the Package.swift file.","type":"text"}]}],"code":null,"content":[{"type":"paragraph","inlineContent":[{"text":"Open our Swift package in Xcode.","type":"text"}]}],"media":"1-1-3.png","type":"step","runtimePreview":null}],"contentSection":[{"kind":"contentAndMedia","mediaPosition":"trailing","media":"1-1-0.png","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Before building the Reminder, you’ll create a new Swift Executable project using Swift Package Manager."}]}]}]},{"contentSection":[{"kind":"contentAndMedia","mediaPosition":"trailing","media":"1-2-0.png","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"It’s time to create a custom Type to represent your Reminders in code."}]}]}],"anchor":"Create-A-Reminder-Struct","stepsSection":[{"media":"1-2-1.png","caption":[],"code":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"First create a Reminder.swift file that we can place our struct into."}]}],"runtimePreview":null},{"code":"1-2-2.swift","caption":[{"inlineContent":[{"text":"Because Reminders will be sent asynchronously to cross concurrency boundaries, and will only be holding simple value types, Struct is the best choice for our Reminder type, for now.","type":"text"}],"type":"paragraph"}],"runtimePreview":null,"media":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Define a Struct named Reminder."}]}],"type":"step"},{"type":"step","runtimePreview":null,"code":"1-2-3.swift","caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Our simple case only needs a "},{"type":"codeVoice","code":"Double"},{"type":"text","text":" for the duration. In a real reminder app, a Date type would be more appropriate."}]}],"content":[{"inlineContent":[{"text":"Define stored properties for the text of the Reminder, and a value for how long before the reminder gets sent.","type":"text"}],"type":"paragraph"}],"media":null},{"inlineContent":[{"text":"It’s best practice when dealing with values that represent Time to specify the units in the documentation for the property.","type":"text"}],"type":"paragraph"},{"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You can use the Command-Option-Slash ( "},{"type":"strong","inlineContent":[{"text":"⌘-⌥-\/","type":"text"}]},{"type":"text","text":" ) hotkey to auto-generate documentation stubs for any symbol in your code."}]}],"code":"1-2-3-comment.swift","media":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"Add a documentation comment for our duration specifying the unit of time being measured.","type":"text"}]}],"runtimePreview":null},{"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Knowing that tags should be unique strings helps with deciding that this collection should be a Set of Strings. There would be no reason for a Reminder to have the same tag set twice!"}]}],"content":[{"inlineContent":[{"type":"text","text":"Define a stored property to hold a collection of strings to act as tags for the reminder. This allows users to more easily filter what reminders will show."}],"type":"paragraph"}],"media":null,"code":"1-2-4.swift","runtimePreview":null,"type":"step"},{"caption":[],"content":[{"inlineContent":[{"text":"Finally, make it so that if your Reminder is passed to the ","type":"text"},{"code":"print()","type":"codeVoice"},{"type":"text","text":" function, it will print in a well-formatted way. For now, let’s just return the title and then the set of tags on the next line with an indentation."}],"type":"paragraph"}],"media":null,"code":"1-2-5.swift","runtimePreview":null,"type":"step"}],"title":"Create A Reminder Struct"}]},{"title":"Delivering Reminders","kind":"callToAction","abstract":[{"text":"Deliver Reminders to the user by formatting them and printing them to the terminal.","type":"text"}],"featuredEyebrow":"Tutorial","action":{"overridingTitleInlineContent":[{"type":"text","text":"Get started"}],"type":"reference","overridingTitle":"Get started","identifier":"doc:\/\/Documentation\/tutorials\/Documentation\/2-Delivering","isActive":true}}],"metadata":{"categoryPathComponent":"0-TOC","title":"Building Reminders","role":"project","category":"Class 5 - Concurrency"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Documentation\/tutorials\/Documentation\/1-Reminder"},"references":{"1-2-3-comment.swift":{"content":["struct Reminder {","    let text: String","    \/\/\/ Time before the Reminder should fire, in seconds.","    let duration: Double","}"],"highlights":[{"line":3}],"type":"file","fileName":"Reminder.swift","identifier":"1-2-3-comment.swift","fileType":"swift","syntax":"swift"},"1-1-0.png":{"alt":null,"identifier":"1-1-0.png","variants":[{"url":"\/images\/Documentation\/1-1-0@2x.png","traits":["2x","light"]}],"type":"image"},"1-1-1.png":{"type":"image","identifier":"1-1-1.png","variants":[{"url":"\/images\/Documentation\/1-1-1@2x.png","traits":["2x","light"]}],"alt":null},"1-0-0.png":{"alt":null,"identifier":"1-0-0.png","variants":[{"url":"\/images\/Documentation\/1-0-0@2x.png","traits":["2x","light"]}],"type":"image"},"1-1-2.png":{"type":"image","identifier":"1-1-2.png","variants":[{"url":"\/images\/Documentation\/1-1-2@2x.png","traits":["2x","light"]}],"alt":null},"1-2-5.swift":