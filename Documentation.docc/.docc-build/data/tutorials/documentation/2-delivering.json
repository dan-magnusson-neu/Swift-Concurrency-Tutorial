{"metadata":{"role":"project","title":"Delivering Reminders","categoryPathComponent":"0-TOC","category":"Class 5 - Concurrency"},"kind":"project","hierarchy":{"paths":[["doc:\/\/Documentation\/tutorials\/0-TOC","doc:\/\/Documentation\/tutorials\/0-TOC\/$volume","doc:\/\/Documentation\/tutorials\/0-TOC\/What's-in-a-Reminder-"]],"modules":[{"reference":"doc:\/\/Documentation\/tutorials\/0-TOC\/What's-in-a-Reminder-","projects":[{"reference":"doc:\/\/Documentation\/tutorials\/Documentation\/1-Reminder","sections":[{"reference":"doc:\/\/Documentation\/tutorials\/Documentation\/1-Reminder#Setting-Up-The-Project","kind":"task"},{"kind":"task","reference":"doc:\/\/Documentation\/tutorials\/Documentation\/1-Reminder#Create-A-Reminder-Struct"}]},{"reference":"doc:\/\/Documentation\/tutorials\/Documentation\/2-Delivering","sections":[{"reference":"doc:\/\/Documentation\/tutorials\/Documentation\/2-Delivering#Building-a-ReminderManager","kind":"task"},{"reference":"doc:\/\/Documentation\/tutorials\/Documentation\/2-Delivering#Building-and-Delivering-Reminders-In-mainswift","kind":"task"}]},{"reference":"doc:\/\/Documentation\/tutorials\/Documentation\/4-Concurrency","sections":[{"kind":"task","reference":"doc:\/\/Documentation\/tutorials\/Documentation\/4-Concurrency#Delivering-Reminders-Concurrently"}]}]}],"reference":"doc:\/\/Documentation\/tutorials\/0-TOC"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/documentation\/2-delivering"]}],"identifier":{"url":"doc:\/\/Documentation\/tutorials\/Documentation\/2-Delivering","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[{"title":"Delivering Reminders","backgroundImage":"1-0-0.png","estimatedTimeInMinutes":20,"content":[{"inlineContent":[{"type":"text","text":"Deliver Reminders to the user by formatting them and printing them to the terminal."}],"type":"paragraph"}],"kind":"hero","image":"1-0-0.png","chapter":"What's in a Reminder?"},{"tasks":[{"stepsSection":[{"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a new ReminderManager.swift file."}]}],"type":"step","caption":[],"media":null,"code":"2-1-1.swift"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Add a variable stored property, ","type":"text"},{"type":"codeVoice","code":"reminders"},{"type":"text","text":" to the "},{"type":"codeVoice","code":"ReminderManager"},{"text":", so it can track the Reminders.","type":"text"}]}],"type":"step","media":null,"code":"2-1-2.swift","caption":[{"inlineContent":[{"text":"By setting this property to private, you can prevent other developers from making ","type":"text"},{"code":"ReminderManager","type":"codeVoice"},{"type":"text","text":" remove a "},{"type":"codeVoice","code":"Reminder"},{"text":" when they shouldn’t.","type":"text"}],"type":"paragraph"}],"runtimePreview":null},{"content":[{"inlineContent":[{"type":"text","text":"Create a function to add Reminders to your "},{"code":"reminders","type":"codeVoice"},{"type":"text","text":" collection."}],"type":"paragraph"}],"caption":[{"inlineContent":[{"type":"text","text":"Because we don’t want others modifying our "},{"type":"codeVoice","code":"reminders"},{"text":" externally in whatever way they want, we’ll need to “wrap” one of the functions of that property with one of our own. This is a fairly common pattern when building containers on top of other containers, and is similar to (but not quite) the Decorator pattern.","type":"text"}],"type":"paragraph"}],"type":"step","media":null,"code":"2-1-3.swift","runtimePreview":null},{"inlineContent":[{"text":"To use the global sleep function, you need to import the library which defines it - Foundation.","type":"text"}],"type":"paragraph"},{"media":null,"type":"step","caption":[{"type":"paragraph","inlineContent":[{"text":"Because we are not yet building this async, our Reminders will print out sequentially, with each one’s duration ticking after the next.","type":"text"}]}],"content":[{"type":"paragraph","inlineContent":[{"text":"Import Foundation and build a function called ","type":"text"},{"type":"codeVoice","code":"run()"},{"type":"text","text":" that will print our Reminders to the terminal after the duration has passed for that reminder."}]}],"code":"2-1-4.swift","runtimePreview":null},{"type":"paragraph","inlineContent":[{"text":"Currently this loses data due to casting from Double to UInt32 (it will floor any decimal values). This is OK for now, as future steps will fix this issue.","type":"text"}]}],"anchor":"Building-a-ReminderManager","contentSection":[{"kind":"contentAndMedia","mediaPosition":"trailing","content":[{"inlineContent":[{"text":"Build a ReminderManager that keeps track of all active Reminders and prints them when necessary.","type":"text"}],"type":"paragraph"}]}],"title":"Building a ReminderManager"},{"stepsSection":[{"caption":[],"content":[{"type":"paragraph","inlineContent":[{"text":"In main.swift, declare an instance of our ","type":"text"},{"type":"codeVoice","code":"ReminderManager"},{"type":"text","text":"."}]}],"type":"step","runtimePreview":null,"media":null,"code":"2-2-1.swift"},{"content":[{"inlineContent":[{"type":"text","text":"Create an array of reminders for us to print out."}],"type":"paragraph"}],"caption":[{"type":"paragraph","inlineContent":[{"text":"In a real-world application you would be receiving these from a file, the network, or user input. For now, we are doing what’s called “mocking” the data for testing purposes.","type":"text"}]}],"type":"step","media":null,"code":"2-2-2.swift","runtimePreview":null},{"caption":[{"inlineContent":[{"type":"text","text":"You could also define an initiliazer for "},{"code":"ReminderManager","type":"codeVoice"},{"text":" and pass an array of reminders to that instead, but we want our interface to be able to add new reminders at later times.","type":"text"}],"type":"paragraph"}],"code":"2-2-3.swift","content":[{"inlineContent":[{"text":"Iterate through the list of reminders and add them to the manager.","type":"text"}],"type":"paragraph"}],"media":null,"runtimePreview":null,"type":"step"},{"runtimePreview":"2-2-4-image.png","content":[{"inlineContent":[{"type":"text","text":"Call the run function on the manager."}],"type":"paragraph"}],"media":null,"code":"2-2-4.swift","caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You should see something similar to the preview in your terminal."}]}],"type":"step"}],"anchor":"Building-and-Delivering-Reminders-In-mainswift","title":"Building and Delivering Reminders In main.swift","contentSection":[{"mediaPosition":"trailing","kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"By using an instance of "},{"type":"codeVoice","code":"ReminderManager"},{"type":"text","text":", we can keep track of our reminders and print them out as needed."}]}]}]}],"kind":"tasks"},{"abstract":[{"text":"Modify your executable application to work well with Swift Concurrency.","type":"text"}],"kind":"callToAction","action":{"type":"reference","identifier":"doc:\/\/Documentation\/tutorials\/Documentation\/4-Concurrency","overridingTitle":"Get started","isActive":true,"overridingTitleInlineContent":[{"type":"text","text":"Get started"}]},"featuredEyebrow":"Tutorial","title":"Swift Concurrency"}],"references":{"doc://Documentation/tutorials/Documentation/2-Delivering":{"type":"topic","role":"project","title":"Delivering Reminders","kind":"project","url":"\/tutorials\/documentation\/2-delivering","abstract":[{"text":"Deliver Reminders to the user by formatting them and printing them to the terminal.","type":"text"}],"identifier":"doc:\/\/Documentation\/tutorials\/Documentation\/2-Delivering","estimatedTime":"20min"},"doc://Documentation/tutorials/Documentation/1-Reminder#Create-A-Reminder-Struct":{"type":"section","url":"\/tutorials\/documentation\/1-reminder#Create-A-Reminder-Struct","role":"pseudoSymbol","identifier":"doc:\/\/Documenta